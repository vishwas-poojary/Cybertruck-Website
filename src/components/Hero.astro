---
// Hero Section matching Screenshot 1 from tesla.com/cybertruck
const graffitiLogo = `${import.meta.env.BASE_URL}cybertruck-graffiti.svg`;
const heroBg = `${import.meta.env.BASE_URL}car.avif`;
---

<section
  id="hero"
  class="relative min-h-screen w-full flex flex-col justify-between overflow-hidden bg-[#090b10] select-none"
>
  <!-- Background Image: Cybertruck parked on rocky desert ledge at dusk (Screenshot 1) -->
  <div class="absolute inset-0 z-0">
    <img
      src={heroBg}
      alt="Tesla Cybertruck at dusk"
      class="w-full h-full object-cover object-center brightness-100 contrast-[1.02]"
      loading="eager"
    />
  </div>

  <!-- Center Hero Content (Graffiti Logo, Lease, & Dual CTAs) -->
  <div
    class="relative z-10 pt-24 sm:pt-28 md:pt-32 text-center px-4 max-w-4xl mx-auto flex flex-col items-center"
  >
    <!-- Authentic Spray-Paint Graffiti Cybertruck Logo (Exact proportions matching live reference site) -->
    <div
      class="w-full max-w-[240px] sm:max-w-[270px] md:max-w-[285px] drop-shadow-[0_10px_35px_rgba(0,0,0,0.8)]"
    >
      <img
        src={graffitiLogo}
        alt="CYBERTRUCK"
        class="w-full h-auto filter invert brightness-200"
      />
    </div>

    <!-- Lease Subtitle (Matching live reference site) -->
    <a
      href="#order"
      class="text-white/95 text-[13px] sm:text-sm font-medium tracking-normal mt-2 sm:mt-2.5 hover:text-white transition-colors drop-shadow-md underline underline-offset-4 decoration-white/60"
    >
      Lease From $1,129/mo
    </a>

    <!-- Dual Action Buttons (Exact proportions, subtle rounded corners, and padding matching live site) -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-2.5 mt-5 sm:mt-6 w-full max-w-[430px] mx-auto"
    >
      <!-- Order Now (Tesla Electric Blue #3e6ae1, rounded-[4px], h-[38px] sm:h-[40px]) -->
      <a
        href="#order"
        class="w-full sm:w-[190px] md:w-[200px] h-[38px] sm:h-[40px] rounded-[4px] inline-flex items-center justify-center bg-[#3e6ae1] hover:bg-[#345abf] text-white font-medium text-[13px] sm:text-sm tracking-normal text-center transition-all active:scale-[0.99] shadow-none box-border border-0"
      >
        Order Now
      </a>

      <!-- Compare Models (Solid Crisp White #ffffff, rounded-[4px], h-[38px] sm:h-[40px]) -->
      <a
        href="#specs"
        class="w-full sm:w-[190px] md:w-[200px] h-[38px] sm:h-[40px] rounded-[4px] inline-flex items-center justify-center bg-white hover:bg-neutral-100 text-[#171a20] font-medium text-[13px] sm:text-sm tracking-normal text-center transition-all active:scale-[0.99] shadow-none box-border border-0"
      >
        Compare Models
      </a>
    </div>
  </div>

  <!-- Bottom Stats & Disclaimer (Matching live reference site layout) -->
  <div
    class="relative z-10 pb-16 sm:pb-20 px-6 max-w-4xl mx-auto w-full flex flex-col items-center"
  >
    <!-- Key Specifications on the Rock Ledge -->
    <div
      class="flex items-center justify-center gap-10 sm:gap-16 md:gap-20 text-center my-3 sm:my-4"
    >
      <!-- 5-Star Safety -->
      <div>
        <div
          class="font-['Blender_TSL',-apple-system,Arial,sans-serif] text-xl sm:text-2xl md:text-[26px] leading-tight font-medium text-white tracking-tight drop-shadow-md block"
        >
          5-Star
        </div>
        <div
          class="text-xs sm:text-[12.5px] text-white/90 font-normal tracking-tight mt-1.5 sm:mt-2 drop-shadow"
        >
          Safety Rating¹
        </div>
      </div>

      <!-- 325 mi Range -->
      <div>
        <div
          class="font-['Blender_TSL',-apple-system,Arial,sans-serif] text-xl sm:text-2xl md:text-[26px] leading-tight font-medium text-white tracking-tight drop-shadow-md block"
        >
          325 mi
        </div>
        <div
          class="text-xs sm:text-[12.5px] text-white/90 font-normal tracking-tight mt-1.5 sm:mt-2 drop-shadow"
        >
          Range (EPA est.)²
        </div>
      </div>

      <!-- 6'x4' Bed -->
      <div>
        <div
          class="font-['Blender_TSL',-apple-system,Arial,sans-serif] text-xl sm:text-2xl md:text-[26px] leading-tight font-medium text-white tracking-tight drop-shadow-md block"
        >
          6'x4'
        </div>
        <div
          class="text-xs sm:text-[12.5px] text-white/90 font-normal tracking-tight mt-1.5 sm:mt-2 drop-shadow"
        >
          Bed
        </div>
      </div>
    </div>

    <!-- Fine Print Disclaimer -->
    <p
      class="text-[10px] sm:text-[11px] text-white/70 font-normal tracking-tight text-center drop-shadow mt-1"
    >
      Images shown depict Cybertruck Premium AWD with optional upgrades.
    </p>
  </div>
</section>
