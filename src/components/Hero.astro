---
// Hero Section matching Screenshot 1 from tesla.com/cybertruck
const graffitiLogo = `${import.meta.env.BASE_URL}cybertruck-graffiti.svg`;
const heroBg = `${import.meta.env.BASE_URL}car.avif`;
---

<section
  id="hero"
  class="relative min-h-screen w-full flex flex-col justify-between overflow-hidden bg-[#090b10] select-none"
>
  <!-- Background Image: Cybertruck parked on rocky desert ledge at dusk (Screenshot 1) -->
  <div class="absolute inset-0 z-0">
    <img
      src={heroBg}
      alt="Tesla Cybertruck at dusk"
      class="w-full h-full object-cover object-center brightness-100 contrast-[1.02]"
      loading="eager"
    />
  </div>

  <!-- Center Hero Content (Graffiti Logo, Lease, & Dual CTAs) -->
  <div
    class="relative z-10 pt-32 sm:pt-36 md:pt-40 text-center px-4 max-w-4xl mx-auto flex flex-col items-center"
  >
    <!-- Authentic Spray-Paint Graffiti Cybertruck Logo (Screenshot 1) -->
    <div
      class="w-full max-w-[340px] sm:max-w-[480px] md:max-w-[540px] drop-shadow-[0_10px_35px_rgba(0,0,0,0.8)]"
    >
      <img
        src={graffitiLogo}
        alt="CYBERTRUCK"
        class="w-full h-auto filter invert brightness-200"
      />
    </div>

    <!-- Lease Subtitle (Matching screenshot 3bf2e2f3) -->
    <a
      href="#order"
      class="text-white font-['Blender_TSL',sans-serif] text-base sm:text-[19px] font-medium tracking-wide mt-3 hover:text-neutral-200 transition-colors drop-shadow-md underline underline-offset-[5px] decoration-white decoration-1"
    >
      Lease From $1,129/mo
    </a>

    <!-- Dual Action Buttons (Exact 250px x 50px sharp rectangular styling from screenshot 3bf2e2f3) -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-2.5 mt-7 w-full max-w-[510px] mx-auto"
    >
      <!-- Order Now (Tesla Electric Blue #3e6ae1, sharp corners, 250x50) -->
      <a
        href="#order"
        class="w-full sm:w-[250px] h-[50px] rounded-none inline-flex items-center justify-center bg-[#3e6ae1] hover:bg-[#345abf] text-white font-['Blender_TSL',sans-serif] font-medium text-[15px] tracking-wide text-center transition-all active:scale-[0.99] shadow-sm box-border border-0"
      >
        Order Now
      </a>

      <!-- Compare Models (Solid Crisp White #ffffff, sharp corners, 250x50) -->
      <a
        href="#specs"
        class="w-full sm:w-[250px] h-[50px] rounded-none inline-flex items-center justify-center bg-white hover:bg-neutral-100 text-[#171a20] font-['Blender_TSL',sans-serif] font-medium text-[15px] tracking-wide text-center transition-all active:scale-[0.99] shadow-sm box-border border-0"
      >
        Compare Models
      </a>
    </div>
  </div>

  <!-- Bottom Stats & Disclaimer (Screenshot 1 & Screenshot 3) -->
  <div
    class="relative z-10 pb-20 sm:pb-24 px-6 max-w-6xl mx-auto w-full flex flex-col items-center"
  >
    <!-- Key Specifications on the Rock Ledge (Matching Screenshot 3 from DevTools) -->
    <div
      class="flex items-center justify-center gap-8 sm:gap-16 md:gap-24 text-center my-6"
    >
      <!-- 5-Star Safety -->
      <div>
        <div
          class="font-['Blender_TSL',-apple-system,Arial,sans-serif] text-[28px] leading-[36px] font-medium text-white tracking-tight drop-shadow-md block h-9"
          style="font-family: 'Blender TSL', -apple-system, Arial, sans-serif; font-size: 28px; font-weight: 500; line-height: 36px; color: rgb(255, 255, 255); box-sizing: border-box;"
        >
          5-Star
        </div>
        <div
          class="text-xs text-white font-normal tracking-tight mt-0.5 drop-shadow"
        >
          Safety Rating¹
        </div>
      </div>

      <!-- 325 mi Range -->
      <div>
        <div
          class="font-['Blender_TSL',-apple-system,Arial,sans-serif] text-[28px] leading-[36px] font-medium text-white tracking-tight drop-shadow-md block h-9"
          style="font-family: 'Blender TSL', -apple-system, Arial, sans-serif; font-size: 28px; font-weight: 500; line-height: 36px; color: rgb(255, 255, 255); box-sizing: border-box;"
        >
          325 mi
        </div>
        <div
          class="text-xs text-white font-normal tracking-tight mt-0.5 drop-shadow"
        >
          Range (EPA est.)²
        </div>
      </div>

      <!-- 6'x4' Bed -->
      <div>
        <div
          class="font-['Blender_TSL',-apple-system,Arial,sans-serif] text-[28px] leading-[36px] font-medium text-white tracking-tight drop-shadow-md block h-9"
          style="font-family: 'Blender TSL', -apple-system, Arial, sans-serif; font-size: 28px; font-weight: 500; line-height: 36px; color: rgb(255, 255, 255); box-sizing: border-box;"
        >
          6'x4'
        </div>
        <div
          class="text-xs text-white font-normal tracking-tight mt-0.5 drop-shadow"
        >
          Bed
        </div>
      </div>
    </div>

    <!-- Fine Print Disclaimer -->
    <p
      class="text-[10px] sm:text-[11px] text-neutral-300 font-normal tracking-tight text-center opacity-90 drop-shadow"
    >
      Images shown depict Cybertruck Premium AWD with optional upgrades.
    </p>
  </div>
</section>
