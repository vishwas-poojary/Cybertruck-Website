---
// Beast Mode Performance Section with 0-60 MPH Interactive Launch Simulator
---

<section id="performance" class="relative py-28 px-6 md:px-12 bg-black border-t border-white/5 overflow-hidden">
  <!-- Glowing red ambient underglow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-96 bg-red-600/10 blur-[150px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & Core Highlights -->
      <div class="lg:col-span-5">
        <span class="text-xs uppercase font-mono tracking-widest text-red-500 font-semibold mb-2 block">
          // TRI-MOTOR BEAST MODE
        </span>
        <h2 class="font-['Chakra_Petch',sans-serif] font-black text-3xl sm:text-5xl text-white tracking-wide uppercase leading-tight">
          RELENTLESS ACCELERATION. 0-60 IN 2.6S.
        </h2>
        <p class="text-neutral-400 mt-5 text-base sm:text-lg leading-relaxed">
          Beast Mode delivers supercar acceleration in a full-sized 6,800 lb truck. In fact, Cybertruck can beat a Porsche 911 in a quarter-mile drag race while towing another Porsche 911 behind it.
        </p>

        <!-- Steer-by-Wire & 4-Wheel Steering -->
        <div class="mt-8 p-5 rounded-xl bg-neutral-950 border border-white/10">
          <div class="text-red-500 font-mono text-xs uppercase mb-1">True Steer-by-Wire</div>
          <h4 class="text-white font-bold text-lg font-['Chakra_Petch',sans-serif]">Rear-Axle Steering Agility</h4>
          <p class="text-xs text-neutral-400 mt-2 leading-relaxed">
            Eliminates mechanical steering column in favor of redundant electric actuators. Combined with active rear-wheel steering, Cybertruck turns tighter than a Tesla Model S sedan in crowded parking lots.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-3 mt-6">
          <div class="p-3 rounded-xl bg-neutral-950 border border-white/10 text-center">
            <div class="text-xl sm:text-2xl font-black text-white font-['Chakra_Petch',sans-serif]">845 <span class="text-xs font-normal text-neutral-400">HP</span></div>
            <div class="text-[10px] text-neutral-400 font-mono uppercase mt-0.5">Tri-Motor Output</div>
          </div>
          <div class="p-3 rounded-xl bg-neutral-950 border border-white/10 text-center">
            <div class="text-xl sm:text-2xl font-black text-white font-['Chakra_Petch',sans-serif]">130 <span class="text-xs font-normal text-neutral-400">MPH</span></div>
            <div class="text-[10px] text-neutral-400 font-mono uppercase mt-0.5">Top Speed</div>
          </div>
          <div class="p-3 rounded-xl bg-neutral-950 border border-white/10 text-center">
            <div class="text-xl sm:text-2xl font-black text-white font-['Chakra_Petch',sans-serif]">10,296</div>
            <div class="text-[10px] text-neutral-400 font-mono uppercase mt-0.5">LB-FT Torque</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive 0-60 MPH Launch Simulator -->
      <div class="lg:col-span-7">
        <div class="relative rounded-2xl overflow-hidden border border-red-500/20 bg-neutral-950 p-6 sm:p-8 shadow-[0_0_50px_rgba(232,33,39,0.15)]">
          <!-- Launch Track / Speedometer Display -->
          <div class="relative rounded-xl overflow-hidden bg-neutral-900 border border-white/10 p-8 text-center select-none">
            <!-- Beast Mode Banner -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/80 border border-red-500/40 text-red-400 text-xs font-mono uppercase tracking-widest mb-6">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
              BEAST LAUNCH MODE ARMED
            </div>

            <!-- Dynamic Speedometer Dial -->
            <div class="my-6">
              <div id="speed-display" class="font-['Chakra_Petch',sans-serif] font-black text-7xl sm:text-9xl text-white tracking-tighter drop-shadow-[0_0_30px_rgba(232,33,39,0.5)]">
                0
              </div>
              <div class="text-sm font-mono uppercase tracking-widest text-neutral-400 mt-2">
                MILES PER HOUR (MPH)
              </div>
            </div>

            <!-- Elapsed Timer & G-Force -->
            <div class="grid grid-cols-2 gap-4 max-w-xs mx-auto my-6 text-center">
              <div class="p-2.5 rounded-lg bg-black/50 border border-white/10">
                <div class="text-[10px] uppercase font-mono text-neutral-400">0-60 Timer</div>
                <div id="launch-timer" class="text-xl font-bold font-mono text-emerald-400 mt-0.5">0.00 s</div>
              </div>
              <div class="p-2.5 rounded-lg bg-black/50 border border-white/10">
                <div class="text-[10px] uppercase font-mono text-neutral-400">Peak G-Force</div>
                <div id="launch-gforce" class="text-xl font-bold font-mono text-red-400 mt-0.5">0.0 G</div>
              </div>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-neutral-800 rounded-full h-3 mb-8 overflow-hidden">
              <div id="launch-progress" class="bg-gradient-to-r from-red-600 to-amber-500 h-full w-0 transition-all"></div>
            </div>

            <!-- Interactive Launch Pedal Button -->
            <button
              id="launch-pedal-btn"
              class="w-full sm:w-auto px-10 py-4 rounded-xl bg-red-600 hover:bg-red-500 text-white font-['Chakra_Petch',sans-serif] font-bold text-base sm:text-lg tracking-wider uppercase transition-all shadow-[0_0_30px_rgba(232,33,39,0.5)] active:scale-95"
            >
              PRESS TO LAUNCH BEAST MODE
            </button>
            <p class="text-neutral-500 font-mono text-xs mt-3">
              Click and experience simulated 0-60 launch acceleration in real time
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { playBeastAcceleration } from '../utils/cyberSound';

  const launchPedalBtn = document.getElementById('launch-pedal-btn');
  const speedDisplay = document.getElementById('speed-display');
  const launchTimer = document.getElementById('launch-timer');
  const launchGforce = document.getElementById('launch-gforce');
  const launchProgress = document.getElementById('launch-progress');

  let isLaunching = false;

  launchPedalBtn?.addEventListener('click', () => {
    if (isLaunching) return;
    isLaunching = true;
    playBeastAcceleration();

    const startTime = performance.now();
    const duration = 2600; // 2.6 seconds

    function step(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);

      // Ease in acceleration curve
      const currentSpeed = Math.round(progress * 60);
      const currentSeconds = (Math.min(elapsed, duration) / 1000).toFixed(2);
      const currentG = (progress * 1.4).toFixed(1);

      if (speedDisplay) speedDisplay.innerText = currentSpeed.toString();
      if (launchTimer) launchTimer.innerText = `${currentSeconds} s`;
      if (launchGforce) launchGforce.innerText = `${currentG} G`;
      if (launchProgress) launchProgress.style.width = `${progress * 100}%`;

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        if (launchPedalBtn) {
          launchPedalBtn.innerText = 'LAUNCH COMPLETE (2.60s) - RELAUNCH';
        }
        isLaunching = false;
      }
    }

    requestAnimationFrame(step);
  });
</script>

