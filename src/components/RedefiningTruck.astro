---
// Redefining the Pickup Truck section with chamfered video player matching Screenshots
const videoSrc = `${import.meta.env.BASE_URL}Cybertruck-Redefining-Desktop-v2.webm`;
---

<section id="redefining" class="relative bg-white text-[#171a20] py-16 md:py-24 px-6 md:px-12 select-none overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <!-- Chamfered Video Container (Exact Cybertruck angular geometry from screenshots) -->
    <div class="relative w-full overflow-hidden shadow-2xl group">
      <!-- Angled Cut Video Box (Top-right & Bottom-left 45-degree chamfers) -->
      <div
        class="redefining-video-wrapper relative w-full aspect-[16/9] sm:aspect-[21/9] bg-neutral-900 overflow-hidden"
        style="clip-path: polygon(0 0, calc(100% - 36px) 0, 100% 36px, 100% 100%, 36px 100%, 0 calc(100% - 36px));"
      >
        <video
          id="redefining-video"
          autoplay
          loop
          muted
          playsinline
          class="w-full h-full object-cover object-center"
        >
          <source src={videoSrc} type="video/webm" />
        </video>

        <!-- Bottom-Left Play / Pause Button (Exact match to screenshot 1) -->
        <button
          id="redefining-play-pause-btn"
          class="absolute bottom-6 left-6 z-20 w-11 h-11 rounded-lg bg-black/40 hover:bg-black/70 backdrop-blur-md border border-white/20 text-white flex items-center justify-center transition-all cursor-pointer active:scale-95 shadow-lg"
          aria-label="Pause or play video"
          title="Pause / Play"
        >
          <!-- Pause Icon (Default) -->
          <svg id="pause-icon" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <rect x="6" y="4" width="4" height="16" rx="1"/>
            <rect x="14" y="4" width="4" height="16" rx="1"/>
          </svg>
          <!-- Play Icon (Hidden) -->
          <svg id="play-icon" class="w-4 h-4 fill-current hidden ml-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Section Copy (Exact match to screenshot 1) -->
    <div class="mt-10 sm:mt-14 max-w-4xl">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-[#171a20]">
        Redefining the Pickup Truck
      </h2>
      <p class="text-neutral-600 text-base sm:text-lg md:text-xl font-normal mt-3.5 leading-relaxed">
        Whatever the task, terrain or weather—Cybertruck was designed to do it all.
      </p>
    </div>
  </div>
</section>

<!-- Floating Chat Assistant Bubble on bottom-right (Screenshot 1) -->
<button
  id="floating-chat-btn"
  class="fixed bottom-6 right-6 z-30 w-12 h-12 rounded-xl bg-[#171a20] hover:bg-black text-white flex items-center justify-center shadow-2xl transition-transform hover:scale-105 active:scale-95 border border-white/10"
  aria-label="Ask Tesla"
  title="Chat with Tesla"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
  </svg>
</button>

<script>
  import { playCyberClick } from '../utils/cyberSound';

  const video = document.getElementById('redefining-video') as HTMLVideoElement;
  const btn = document.getElementById('redefining-play-pause-btn');
  const pauseIcon = document.getElementById('pause-icon');
  const playIcon = document.getElementById('play-icon');

  btn?.addEventListener('click', () => {
    playCyberClick();
    if (!video) return;

    if (video.paused) {
      video.play();
      pauseIcon?.classList.remove('hidden');
      playIcon?.classList.add('hidden');
    } else {
      video.pause();
      pauseIcon?.classList.add('hidden');
      playIcon?.classList.remove('hidden');
    }
  });

  // Floating chat button interaction
  const chatBtn = document.getElementById('floating-chat-btn');
  const demoModal = document.getElementById('demo-drive-modal');
  chatBtn?.addEventListener('click', () => {
    playCyberClick();
    if (demoModal) {
      demoModal.classList.remove('hidden');
      demoModal.classList.add('flex');
    }
  });
</script>
