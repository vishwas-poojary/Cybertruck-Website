---
// Redefining the Pickup Truck section with chamfered intro video and 5-slide horizontal carousel matching Tesla reference screenshots
const introVideoSrc = `${import.meta.env.BASE_URL}Cybertruck-Redefining-Desktop-v2.webm`;

const carouselSlides = [
  {
    id: 'bring',
    title: 'Bring It All',
    description: 'Weekend road trips, outdoor adventures or a day at the job site—with up to 120 cubic feet of cargo space, you can bring along everything you need. Second-row seat cushions fold up for even more storage.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Redefining-Carousel-Slide-1-Bring-Desktop-v2.webm`,
  },
  {
    id: 'power',
    title: 'Power On Tap',
    description: 'Two 120 V outlets in the cabin and two 120 V outlets in the bed (plus one 240 V outlet for heavy-duty power). Together they deliver up to 9.6 kW of continuous power to run power tools, compressors to charge another EV.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Redefining-Carousel-Slide-2-Power-Desktop-v2.webm`,
  },
  {
    id: 'motion',
    title: 'Full Range of Motion',
    description: 'Navigate tight spaces with standard steer-by-wire and four-wheel steering. Experience tight turns with a turning radius smaller than most sedans.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Redefining-Carousel-Slide-3-Motion-Desktop-v2.webm`,
  },
  {
    id: 'lock',
    title: 'Lockable Storage',
    description: 'Secure and conceal your gear in the motorized tonneau cover and hidden bed vault. Protect tools and equipment from weather and theft.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Redefining-Carousel-Slide-4-Lock-Desktop.webm`,
  },
  {
    id: 'throw',
    title: 'Throw Anything at It',
    description: 'An ultra-hard stainless steel exoskeleton helps reduce dents, damage and long-term corrosion. Built to endure the toughest tasks.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Redefining-Carousel-Slide-5-Throw-Desktop.webm`,
  },
];
---

<section id="redefining" class="relative bg-white text-[#171a20] pt-12 pb-16 md:pt-16 md:pb-20 select-none overflow-hidden">
  <!-- Chamfered Intro Video Container (Refined 24px chamfer matching real Tesla website screenshot bd7a5c16) -->
  <div class="max-w-8xl mx-auto px-6 md:px-8">
    <div class="relative w-full group">
      <div
        class="redefining-video-wrapper relative w-full aspect-[16/9] sm:aspect-[2.33/1] bg-neutral-900 overflow-hidden shadow-sm"
        style="clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));"
      >
        <video
          id="redefining-video"
          autoplay
          loop
          muted
          playsinline
          class="w-full h-full object-cover object-center"
        >
          <source src={introVideoSrc} type="video/webm" />
        </video>

        <!-- Bottom-Left Play / Pause Button (Tesla minimalist overlay style) -->
        <button
          id="redefining-play-pause-btn"
          class="absolute bottom-5 left-5 sm:bottom-6 sm:left-6 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-[6px] bg-black/60 hover:bg-black/80 backdrop-blur-sm text-white flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-95 border-0 shadow-none"
          aria-label="Pause or play video"
          title="Pause / Play"
        >
          <!-- Pause Icon (Default) -->
          <svg id="pause-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white" viewBox="0 0 24 24">
            <rect x="6" y="4" width="3.5" height="16" rx="1"/>
            <rect x="14.5" y="4" width="3.5" height="16" rx="1"/>
          </svg>
          <!-- Play Icon (Hidden) -->
          <svg id="play-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white hidden ml-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Section Copy (Aligned to 11vw starting gutter matching horizontal carousel) -->
  <div class="w-full pl-6 md:pl-[11vw] pr-6 mt-10 sm:mt-14">
    <div id="redefining-text-container" class="max-w-4xl">
      <h2 class="text-[34px] md:text-[40px] leading-[40px] md:leading-[44px] font-medium tracking-tight text-[rgb(23,26,32)]" style="font-family: 'Blender TSL', -apple-system, Arial, sans-serif; font-weight: 500; color: rgb(23, 26, 32);">
        Redefining the Pickup Truck
      </h2>
      <p class="text-[22px] leading-[30px] font-medium text-[rgb(92,94,98)] mt-2 sm:mt-2.5" style="font-family: 'Blender TSL', -apple-system, Arial, sans-serif; font-weight: 500; color: rgb(92, 94, 98);">
        Whatever the task, terrain or weather—Cybertruck was designed to do it all.
      </p>
    </div>
  </div>

  <!-- Horizontal Video Carousel Section (Generous top padding block matching Figma and subtle translucent pill arrow controls) -->
  <div class="relative w-full mt-20 sm:mt-24 md:mt-28">
    <div class="relative w-full">
      <!-- Left Chevron '<' (Square minimalist pill matching live Tesla site) -->
      <button
        id="carousel-prev-btn"
        class="absolute left-3 sm:left-5 md:left-[calc(11vw-20px)] top-[calc(84vw*9/32)] md:top-[calc(min(78vw,1040px)*9/32)] -translate-y-1/2 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-[3px] bg-[#eeeeee]/90 hover:bg-white text-[#171a20] shadow-sm backdrop-blur-sm flex items-center justify-center transition-all duration-200 active:scale-95 cursor-pointer opacity-0 pointer-events-none border border-black/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-black"
        aria-label="Previous slide"
        title="Previous"
      >
        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-[#171a20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Right Chevron '>' (Square minimalist pill matching live Tesla site) -->
      <button
        id="carousel-next-btn"
        class="absolute right-3 sm:right-5 md:right-[calc(11vw-20px)] top-[calc(84vw*9/32)] md:top-[calc(min(78vw,1040px)*9/32)] -translate-y-1/2 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-[3px] bg-[#eeeeee]/90 hover:bg-white text-[#171a20] shadow-sm backdrop-blur-sm flex items-center justify-center transition-all duration-200 active:scale-95 cursor-pointer border border-black/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-black"
        aria-label="Next slide"
        title="Next"
      >
        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-[#171a20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Horizontal Scrollable Track (11vw left margin gap and scroll-padding-left matching real Tesla website) -->
      <div
        id="carousel-track"
        class="relative flex gap-4 sm:gap-6 overflow-x-auto scrollbar-none snap-x snap-mandatory scroll-smooth py-2 w-full pl-6 md:pl-[11vw] scroll-pl-6 md:scroll-pl-[11vw] pr-6 md:pr-[11vw]"
        style="-webkit-overflow-scrolling: touch; scrollbar-width: none;"
      >
        {carouselSlides.map((slide, index) => (
          <div
            class="carousel-card flex-none w-[84vw] md:w-[78vw] max-w-[1040px] snap-start relative group"
            data-index={index}
          >
            <!-- Angular Cut Chamfer Container (16:9 full cinematic height matching real website aa7e42e8 & 5b333db3) -->
            <div
              class="relative w-full aspect-[16/9] bg-neutral-900 overflow-hidden shadow-sm"
              style="clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));"
            >
              <video
                class="carousel-video w-full h-full object-cover object-center"
                loop
                muted
                playsinline
                preload="metadata"
              >
                <source src={slide.src} type="video/webm" />
              </video>

              <!-- Bottom-Left Play / Pause Button on each slide (Tesla minimalist overlay style) -->
              <button
                class="carousel-play-pause-btn absolute bottom-5 left-5 sm:bottom-6 sm:left-6 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-[6px] bg-black/60 hover:bg-black/80 backdrop-blur-sm text-white flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-95 border-0 shadow-none"
                aria-label={`Toggle play/pause for ${slide.title}`}
                data-index={index}
              >
                <!-- Pause Icon (Default when playing) -->
                <svg class="pause-icon-el w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white" viewBox="0 0 24 24">
                  <rect x="6" y="4" width="3.5" height="16" rx="1"/>
                  <rect x="14.5" y="4" width="3.5" height="16" rx="1"/>
                </svg>
                <!-- Play Icon (Hidden when playing) -->
                <svg class="play-icon-el w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white hidden ml-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            </div>

            <!-- Slide Title and Description Directly Underneath Its Video (Exact match to real website screenshot d617ff28) -->
            <div class="mt-4 sm:mt-5 pr-4">
              <h3 class="text-[22px] leading-[30px] font-medium tracking-tight text-[rgb(23,26,32)]" style="font-family: 'Blender TSL', -apple-system, Arial, sans-serif; font-weight: 500; color: rgb(23, 26, 32);">
                {slide.title}
              </h3>
              <p class="text-[rgb(92,94,98)] text-sm sm:text-base font-normal mt-2 leading-relaxed max-w-2xl" style="font-family: 'Blender TSL', -apple-system, Arial, sans-serif; color: rgb(92, 94, 98);">
                {slide.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>


  </div>
</section>



<script>
  import { playCyberClick } from '../utils/cyberSound';

  // Intro video play/pause controls
  const introVideo = document.getElementById('redefining-video') as HTMLVideoElement;
  const introBtn = document.getElementById('redefining-play-pause-btn');
  const introPauseIcon = document.getElementById('pause-icon');
  const introPlayIcon = document.getElementById('play-icon');

  introBtn?.addEventListener('click', () => {
    playCyberClick();
    if (!introVideo) return;

    if (introVideo.paused) {
      introVideo.play();
      introPauseIcon?.classList.remove('hidden');
      introPlayIcon?.classList.add('hidden');
    } else {
      introVideo.pause();
      introPauseIcon?.classList.add('hidden');
      introPlayIcon?.classList.remove('hidden');
    }
  });

  // Carousel Controller
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('carousel-prev-btn');
  const nextBtn = document.getElementById('carousel-next-btn');
  const cards = document.querySelectorAll<HTMLElement>('.carousel-card');
  const videos = document.querySelectorAll<HTMLVideoElement>('.carousel-video');
  const playPauseBtns = document.querySelectorAll<HTMLButtonElement>('.carousel-play-pause-btn');
  const dots = document.querySelectorAll<HTMLButtonElement>('.carousel-dot');

  let currentSlideIndex = 0;

  // Synchronize carousel track padding and scroll snap padding to perfectly match page container left margin
  function syncCarouselMargin() {
    const textContainer = document.getElementById('redefining-text-container');
    const track = document.getElementById('carousel-track');
    if (!textContainer || !track) return;

    const leftOffset = textContainer.getBoundingClientRect().left;
    if (leftOffset > 0) {
      track.style.paddingLeft = `${leftOffset}px`;
      track.style.scrollPaddingLeft = `${leftOffset}px`;
    }
  }

  window.addEventListener('resize', syncCarouselMargin, { passive: true });
  syncCarouselMargin();
  window.addEventListener('load', syncCarouselMargin);

  function scrollToSlide(index: number) {
    if (!track || !cards[index]) return;
    const targetCard = cards[index];
    const trackPaddingLeft = parseFloat(getComputedStyle(track).paddingLeft) || 0;
    // targetCard.offsetLeft measured relative to track (since track has position: relative)
    const scrollTarget = Math.max(0, targetCard.offsetLeft - trackPaddingLeft);
    track.scrollTo({ left: scrollTarget, behavior: 'smooth' });
    updateActiveSlideState(index);
  }

  function updateActiveSlideState(index: number) {
    currentSlideIndex = Math.max(0, Math.min(index, cards.length - 1));

    // Update Chevrons visibility
    if (prevBtn) {
      if (currentSlideIndex === 0) {
        prevBtn.classList.add('opacity-0', 'pointer-events-none');
        prevBtn.classList.remove('opacity-100', 'pointer-events-auto');
      } else {
        prevBtn.classList.remove('opacity-0', 'pointer-events-none');
        prevBtn.classList.add('opacity-100', 'pointer-events-auto');
      }
    }

    if (nextBtn) {
      if (currentSlideIndex === cards.length - 1) {
        nextBtn.classList.add('opacity-0', 'pointer-events-none');
        nextBtn.classList.remove('opacity-100', 'pointer-events-auto');
      } else {
        nextBtn.classList.remove('opacity-0', 'pointer-events-none');
        nextBtn.classList.add('opacity-100', 'pointer-events-auto');
      }
    }

    // Update Dots
    dots.forEach((dot, i) => {
      if (i === currentSlideIndex) {
        dot.classList.add('w-8', 'bg-[#171a20]');
        dot.classList.remove('w-2', 'bg-neutral-300');
      } else {
        dot.classList.remove('w-8', 'bg-[#171a20]');
        dot.classList.add('w-2', 'bg-neutral-300');
      }
    });

    // Autoplay current slide video, pause others
    videos.forEach((video, i) => {
      const btn = playPauseBtns[i];
      const pauseIcon = btn?.querySelector('.pause-icon-el');
      const playIcon = btn?.querySelector('.play-icon-el');

      if (i === currentSlideIndex) {
        video.play().catch(() => {});
        pauseIcon?.classList.remove('hidden');
        playIcon?.classList.add('hidden');
      } else {
        video.pause();
        pauseIcon?.classList.add('hidden');
        playIcon?.classList.remove('hidden');
      }
    });
  }

  // Chevron event listeners
  prevBtn?.addEventListener('click', () => {
    playCyberClick();
    scrollToSlide(currentSlideIndex - 1);
  });

  nextBtn?.addEventListener('click', () => {
    playCyberClick();
    scrollToSlide(currentSlideIndex + 1);
  });

  // Dot event listeners
  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      playCyberClick();
      const slideIdx = parseInt(dot.getAttribute('data-slide') || '0', 10);
      scrollToSlide(slideIdx);
    });
  });

  // Slide play/pause buttons
  playPauseBtns.forEach((btn, index) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      playCyberClick();
      const video = videos[index];
      const pauseIcon = btn.querySelector('.pause-icon-el');
      const playIcon = btn.querySelector('.play-icon-el');
      if (!video) return;

      if (video.paused) {
        video.play();
        pauseIcon?.classList.remove('hidden');
        playIcon?.classList.add('hidden');
      } else {
        video.pause();
        pauseIcon?.classList.add('hidden');
        playIcon?.classList.remove('hidden');
      }
    });
  });

  // Track scroll listener to update state when user swipes / scrolls manually
  let scrollTimeout: number | undefined;
  track?.addEventListener(
    'scroll',
    () => {
      window.clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(() => {
        if (!track) return;
        const scrollLeft = track.scrollLeft;
        let closestIndex = 0;
        let minDiff = Infinity;

        const trackPaddingLeft = parseFloat(getComputedStyle(track).paddingLeft) || 0;
        cards.forEach((card, i) => {
          const cardTarget = card.offsetLeft - trackPaddingLeft;
          const diff = Math.abs(scrollLeft - cardTarget);
          if (diff < minDiff) {
            minDiff = diff;
            closestIndex = i;
          }
        });

        if (closestIndex !== currentSlideIndex) {
          updateActiveSlideState(closestIndex);
        }
      }, 60);
    },
    { passive: true }
  );

  // Initialize carousel on page load
  updateActiveSlideState(0);


</script>

