---
// Fixed Sticky Bottom Interactive Bar (Matching exact Tesla Cybertruck layout from Image 1)
---

<!-- Fixed Center Floating Interactive Action Bar -->
<div
  id="sticky-bottom-bar"
  class="fixed bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 z-40 flex items-center justify-center gap-2 pointer-events-auto select-none px-3"
>
  <!-- Left: Ask a Question Pill -->
  <button
    id="sticky-ask-btn"
    class="flex items-center justify-between h-[38px] px-3.5 rounded-[4px] bg-[#f4f4f4]/95 hover:bg-white text-[#171a20] shadow-[0_2px_8px_rgba(0,0,0,0.1)] backdrop-blur-md text-xs sm:text-[13px] border border-[#d0d1d2] transition-all cursor-pointer gap-2.5 max-w-[340px] sm:max-w-[420px]"
    aria-label="Ask a Question"
  >
    <div class="flex items-center gap-2 overflow-hidden truncate">
      <!-- Chat bubble icon with three dots (Matching Image 1) -->
      <svg
        class="w-4 h-4 text-[#393c41] shrink-0"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h4l4 4 4-4h4c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-12 9c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm4 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm4 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
      </svg>
      <span class="text-[#171a20] font-medium shrink-0">Ask a Question</span>
      <span id="sticky-question-text" class="text-[#5c5e62] font-normal truncate ml-0.5 transition-opacity duration-200"
        >"What's Pet Mode?"</span
      >
    </div>
    <div
      class="w-[22px] h-[22px] rounded-[3px] bg-[#e2e3e5] hover:bg-[#d5d6d8] flex items-center justify-center shrink-0 ml-1 transition-colors"
    >
      <svg
        class="w-3.5 h-3.5 text-[#5c5e62]"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 19V5m-7 7l7-7 7 7"
        ></path>
      </svg>
    </div>
  </button>

  <!-- Right: Schedule a Drive Today Pill (Matching Image 1) -->
  <button
    id="sticky-drive-btn"
    class="open-demo-drive-action flex items-center gap-2 h-[38px] px-3.5 sm:px-4 rounded-[4px] bg-[#f4f4f4]/95 hover:bg-white text-[#171a20] shadow-[0_2px_8px_rgba(0,0,0,0.1)] backdrop-blur-md text-xs sm:text-[13px] font-medium border border-[#d0d1d2] shrink-0 transition-all cursor-pointer active:scale-[0.98]"
  >
    <!-- Steering wheel icon with electric blue spokes (Matching Image 1) -->
    <svg
      class="w-4 h-4 text-[#3e6ae1] shrink-0"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <circle cx="12" cy="12" r="9" stroke-width="2"></circle>
      <circle cx="12" cy="12" r="3" stroke-width="2"></circle>
      <path stroke-linecap="round" stroke-width="2" d="M12 3v6M12 15v6M3 12h6M15 12h6"></path>
    </svg>
    <span class="text-[#171a20] font-medium whitespace-nowrap">Schedule a Drive Today</span>
  </button>
</div>

<script>
  import { playCyberClick } from '../utils/cyberSound';

  // Dynamic question cycling (matching real Tesla experience)
  const questionText = document.getElementById('sticky-question-text');
  const questions = [
    `"What's Pet Mode?"`,
    `"Where can I drive the Cybertruck?"`,
    `"What is Wade Mode?"`,
    `"Compare Model 3 and Model Y"`,
    `"What does the Tesla app do?"`,
  ];
  let qIndex = 0;

  setInterval(() => {
    qIndex = (qIndex + 1) % questions.length;
    if (questionText) {
      questionText.style.opacity = '0';
      setTimeout(() => {
        questionText.textContent = questions[qIndex];
        questionText.style.opacity = '1';
      }, 200);
    }
  }, 6000);

  // Ask button interaction
  const askBtn = document.getElementById('sticky-ask-btn');
  askBtn?.addEventListener('click', () => {
    playCyberClick();
    alert('Tesla Cybertruck Assistant: Ask anything about range, charging, towing or autonomous driving features!');
  });
</script>
