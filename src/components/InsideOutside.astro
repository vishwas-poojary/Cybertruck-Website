    if (!insideTrack || !insideCards[index]) return;
    const targetCard = insideCards[index];
    const trackPaddingLeft = parseFloat(getComputedStyle(insideTrack).paddingLeft) || 0;
    const scrollTarget = Math.max(0, targetCard.offsetLeft - trackPaddingLeft);
    insideTrack.scrollTo({ left: scrollTarget, behavior: 'smooth' });
    updateInsideActiveState(index);
  }

