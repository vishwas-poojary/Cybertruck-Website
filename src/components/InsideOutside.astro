      if (currentInsideIndex === 0) {
        insidePrevBtn.classList.add('opacity-0', 'pointer-events-none');
        insidePrevBtn.classList.remove('opacity-100', 'pointer-events-auto');
      } else {
        insidePrevBtn.classList.remove('opacity-0', 'pointer-events-none');
        insidePrevBtn.classList.add('opacity-100', 'pointer-events-auto');
      }
