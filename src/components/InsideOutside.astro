      if (currentInsideIndex === insideCards.length - 1) {
        insideNextBtn.classList.add('opacity-0', 'pointer-events-none');
        insideNextBtn.classList.remove('opacity-100', 'pointer-events-auto');
      } else {
        insideNextBtn.classList.remove('opacity-0', 'pointer-events-none');
        insideNextBtn.classList.add('opacity-100', 'pointer-events-auto');
      }
