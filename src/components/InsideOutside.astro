---
// Inside/Outside Shatter-Resistant Glass & Cabin View Video Section with 3-slide image carousel
const videoSrc = `${import.meta.env.BASE_URL}Cybertruck-InsideOutside-Desktop-v2.webm`;
const terrainVideoSrc = `${import.meta.env.BASE_URL}Cybertruck-Terrain-Desktop.webm`;
const terrainBadgeSrc = `${import.meta.env.BASE_URL}Cybertruck-Terrain-Badge-Desktop-NA-SA-APAC.avif`;
const autonomousVideoSrc = `${import.meta.env.BASE_URL}Cybertruck-Autonomous-Desktop.webm`;
const safetyVideoSrc = `${import.meta.env.BASE_URL}Cybertruck-Safety-Desktop-v3.webm`;
const accessoriesImageSrc = `${import.meta.env.BASE_URL}Cybertruck-Accessories-Desktop.avif`;
const powershareImageSrc = `${import.meta.env.BASE_URL}Cybertruck-Powershare-Desktop.avif`;
const graffitiLogo = `${import.meta.env.BASE_URL}cybertruck-graffiti.svg`;
const specsDimensionsImg = `${import.meta.env.BASE_URL}Cybertruck-Specs-Dimensions.png`;

const insideCarouselSlides = [
  {
    id: 'ready',
    title: 'Ready When You Are',
    description: 'With driver profiles, your Cybertruck will automatically adjust your seat and wheel position to your preferences. Use the Tesla app before you get in, or the front and rear touchscreens to customize your settings.',
    src: `${import.meta.env.BASE_URL}Cybertruck-InsideOutside-Carousel-Slide-1-Ready-Desktop-v2.avif`,
  },
  {
    id: 'enter',
    title: 'Enter Another World',
    description: 'Adaptive suspension can lower the entry height for easy access when you get in.³ Close the doors and enjoy expansive views of the road while 360-degree acoustic glass keeps the cabin quiet.',
    src: `${import.meta.env.BASE_URL}Cybertruck-InsideOutside-Carousel-Slide-2-Enter-Desktop.avif`,
  },
  {
    id: 'fun',
    title: 'Have More Fun',
    description: 'Front and rear touchscreens keep entertainment within reach.³ Choose custom ambient lighting to match the color of the cabin to your vibe.',
    src: `${import.meta.env.BASE_URL}Cybertruck-InsideOutside-Carousel-Slide-3-Fun-Desktop.avif`,
  },
];

const safetyCarouselSlides = [
  {
    id: 'fsd',
    title: 'Full Self-Driving (Supervised)',
    description: 'A suite of advanced driver-assistance features designed to provide more active guidance and assisted driving under your active supervision.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Safety-Carousel-Slide-1-FSD-Desktop.avif`,
  },
  {
    id: 'safety',
    title: 'Engineered for Your Safety',
    description: 'Active safety features can help reduce impact severity or help prevent accidents altogether. Forward Collision Warning, Active Emergency Braking and Lane Departure Avoidance come standard.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Safety-Carousel-Slide-2-Safety-Desktop.avif`,
  },
  {
    id: 'protect',
    title: 'Protect Your Truck',
    description: 'Enable Sentry Mode to monitor your unattended vehicle and automatically activate the alarm, increase the touchscreen brightness and play music at max volume if a threat is detected.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Safety-Carousel-Slide-3-Protect-Desktop.avif`,
  },
];

const accessoriesCarouselSlides = [
  {
    id: 'crossbars',
    title: 'Crossbars',
    description: 'Transport up to 200 pounds of cargo, maximizing your storage space for bikes, gear mounts and more. Quick-release attachments and telescoping crossbars enable easy installation on any mounting points.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Accessories-Carousel-Slide-1-Crossbars-Desktop.avif`,
  },
  {
    id: 'mudflaps',
    title: 'Mud Flaps',
    description: 'Designed for durability to protect your Cybertruck from snow, salt, sand and small debris.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Accessories-Carousel-Slide-2-MudFlaps-Desktop.avif`,
  },
  {
    id: 'divider',
    title: 'Cargo Divider',
    sup: '3',
    description: 'Constructed from a lightweight, rigid aluminum and can be installed anywhere along the truck bed’s L-track for added customization, utility and security. Secure loose items and mount accessories to the MOLLE panel.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Accessories-Carousel-Slide-3-Divider-Desktop.avif`,
  },
  {
    id: 'ramp',
    title: 'Tailgate Ramp',
    description: 'Make loading and unloading easy. Lightweight and easy to install, this ramp can be used individually to move up to 750 pounds of gear or in pairs to load four-wheel vehicles like Cyberquad (sold separately).',
    src: `${import.meta.env.BASE_URL}Cybertruck-Accessories-Carousel-Slide-4-Ramp-Desktop.avif`,
  },
  {
    id: 'lightbar',
    title: 'Off-Road Lightbar',
    description: 'Off-road after dark. A high-performance light bar that uses LED optical technology to cast a powerful, uniform light beam onto the trail ahead. Control angle, intensity and more through the touchscreen.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Accessories-Carousel-Slide-5-Lightbar-Desktop.avif`,
  },
  {
    id: 'mat',
    title: 'Truck Bed Textile Mat',
    description: 'Keep your bed clean and your cargo protected. Constructed from a waterproof textured fabric for extra durability.',
    src: `${import.meta.env.BASE_URL}Cybertruck-Accessories-Carousel-Slide-6-Mat-Desktop.avif`,
  },
];
---

<section id="inside-outside" class="relative bg-white text-[#171a20] pt-6 pb-0 select-none overflow-hidden">
  <!-- Top Chamfered Single Video Layout -->
  <div class="max-w-10xl mx-auto px-6 md:px-8">
    <div class="relative w-full group">
      <div
        class="inside-outside-video-wrapper relative w-full aspect-[16/9] sm:aspect-[2.33/1] bg-neutral-900 overflow-hidden shadow-sm"
        style="clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));"
      >
        <video
          id="inside-outside-video"
          autoplay
          loop
          muted
          playsinline
          class="w-full h-full object-cover object-center"
        >
          <source src={videoSrc} type="video/webm" />
        </video>

        <!-- Bottom-Left Play / Pause Button (Tesla minimalist overlay style) -->
        <button
          id="inside-outside-play-pause-btn"
          class="absolute bottom-5 left-5 sm:bottom-6 sm:left-6 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-[6px] bg-black/60 hover:bg-black/80 backdrop-blur-sm text-white flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-95 border-0 shadow-none"
          aria-label="Pause or play video"
          title="Pause / Play"
        >
          <!-- Pause Icon (Default) -->
          <svg id="inside-pause-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white" viewBox="0 0 24 24">
            <rect x="6" y="4" width="3.5" height="16" rx="1"/>
            <rect x="14.5" y="4" width="3.5" height="16" rx="1"/>
          </svg>
          <!-- Play Icon (Hidden) -->
          <svg id="inside-play-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white hidden ml-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Section Copy (Aligned to 11vw starting gutter matching horizontal carousel) -->
  <div class="w-full pl-6 md:pl-[11vw] pr-6 mt-12 sm:mt-16 md:mt-20">
    <div id="inside-text-container" class="max-w-4xl">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-[#171a20]">
        Tough on the Outside, Comfortable on the Inside
      </h2>
      <p class="text-neutral-600 text-base sm:text-lg md:text-xl font-normal mt-3.5 leading-relaxed">
        Stainless-steel exterior, premium interior.<sup>3</sup>
      </p>
    </div>
  </div>

  <!-- Horizontal Image Carousel Section (Matching Tesla screenshots 246185a8 & 8953d4ac) -->
  <div class="relative w-full mt-8 sm:mt-12">
    <div class="relative w-full">
      <!-- Left Chevron '<' (Vertically centered over image, compact translucent pill matching Figma & video carousel) -->
      <button
        id="inside-carousel-prev-btn"
        class="absolute left-3 sm:left-5 md:left-[calc(11vw-16px)] top-[calc(82vw*11/32)] md:top-[calc(min(38vw,580px)*11/32)] -translate-y-1/2 z-30 w-8 h-8 sm:w-8.5 sm:h-8.5 rounded-full bg-white/65 hover:bg-white/85 text-[#171a20] shadow-none backdrop-blur-md flex items-center justify-center transition-all duration-200 active:scale-95 cursor-pointer opacity-0 pointer-events-none border border-black/5"
        aria-label="Previous slide"
        title="Previous"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#171a20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Right Chevron '>' (Vertically centered over image, compact translucent pill matching Figma & video carousel) -->
      <button
        id="inside-carousel-next-btn"
        class="absolute right-3 sm:right-5 md:right-[calc(11vw-16px)] top-[calc(82vw*11/32)] md:top-[calc(min(38vw,580px)*11/32)] -translate-y-1/2 z-30 w-8 h-8 sm:w-8.5 sm:h-8.5 rounded-full bg-white/65 hover:bg-white/85 text-[#171a20] shadow-none backdrop-blur-md flex items-center justify-center transition-all duration-200 active:scale-95 cursor-pointer border border-black/5"
        aria-label="Next slide"
        title="Next"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#171a20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Horizontal Scrollable Track -->
      <div
        id="inside-carousel-track"
        class="relative flex gap-4 sm:gap-6 overflow-x-auto scrollbar-none snap-x snap-mandatory scroll-smooth py-2 w-full pl-6 md:pl-[11vw] scroll-pl-6 md:scroll-pl-[11vw] pr-6 md:pr-[11vw]"
        style="-webkit-overflow-scrolling: touch; scrollbar-width: none;"
      >
        {insideCarouselSlides.map((slide, index) => (
          <div
            class="inside-carousel-card flex-none w-[82vw] sm:w-[55vw] md:w-[42vw] lg:w-[38vw] max-w-[580px] snap-start relative group cursor-pointer"
            data-index={index}
          >
            <!-- Angular Cut Chamfer Container -->
            <div
              class="relative w-full aspect-[16/11] bg-neutral-900 overflow-hidden shadow-sm"
              style="clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));"
            >
              <img
                src={slide.src}
                alt={slide.title}
                class="w-full h-full object-cover object-center"
                loading="lazy"
              />
            </div>

            <!-- Slide Title and Description -->
            <div class="mt-4 sm:mt-5 pr-4">
              <h3 class="text-2xl sm:text-3xl font-medium tracking-tight text-[#171a20]">
                {slide.title}
              </h3>
              <p class="text-neutral-600 text-sm sm:text-base font-normal mt-2 leading-relaxed max-w-xl">
                {slide.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>


  </div>

  <!-- Bottom Single Video Layout: Cybertruck Terrain -->
  <div class="max-w-10xl mx-auto px-6 md:px-8 mt-12 sm:mt-16 md:mt-20">
    <div class="relative w-full group">
      <div
        class="terrain-video-wrapper relative w-full aspect-[16/9] sm:aspect-[2.33/1] bg-neutral-900 overflow-hidden shadow-sm"
        style="clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));"
      >
        <video
          id="terrain-video"
          autoplay
          loop
          muted
          playsinline
          class="w-full h-full object-cover object-center"
        >
          <source src={terrainVideoSrc} type="video/webm" />
        </video>

        <!-- Bottom-Left Play / Pause Button (Tesla minimalist overlay style) -->
        <button
          id="terrain-play-pause-btn"
          class="absolute bottom-5 left-5 sm:bottom-6 sm:left-6 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-[6px] bg-black/60 hover:bg-black/80 backdrop-blur-sm text-white flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-95 border-0 shadow-none"
          aria-label="Pause or play terrain video"
          title="Pause / Play"
        >
          <!-- Pause Icon (Default) -->
          <svg id="terrain-pause-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white" viewBox="0 0 24 24">
            <rect x="6" y="4" width="3.5" height="16" rx="1"/>
            <rect x="14.5" y="4" width="3.5" height="16" rx="1"/>
          </svg>
          <!-- Play Icon (Hidden) -->
          <svg id="terrain-play-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white hidden ml-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Take on Any Terrain Content Section (Matching Tesla screenshot) -->
    <div class="mt-12 sm:mt-16 md:mt-20">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-[#171a20]">
        Take on Any Terrain
      </h2>
      <p class="text-neutral-600 text-base sm:text-lg md:text-xl font-normal mt-4 leading-relaxed max-w-4xl">
        For city driving and off-roading, adapt your driving style to match your task or terrain. Drive modes are designed to be versatile and reliable, so you can go anywhere. Use the touchscreen to turn on trailer mode and store your profiles, input your towing load details or select your driving mode to match your terrain. Learn more about off-road controls for <a href="https://digitalassets.tesla.com/tesla-contents/image/upload/Cybertruck_Premium_AWD_and_Cyberbeast_Off-Road_Guide.pdf" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[#171a20] transition-colors">Premium All-Wheel Drive and Cyberbeast</a>, and <a href="https://digitalassets.tesla.com/tesla-contents/image/upload/Cybertruck_Dual_Motor_AWD_Off-Road_Guide.pdf" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[#171a20] transition-colors">Dual Motor All-Wheel Drive</a>.
      </p>

      <!-- 3 Columns for Terrain Modes -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10 mt-12 sm:mt-16">
        <div>
          <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-[#171a20]">
            Slippery Surface
          </h3>
          <p class="text-neutral-600 text-sm sm:text-base font-normal mt-2.5 leading-relaxed">
            Designed for when you lose traction in snowy, rocky or muddy conditions.
          </p>
        </div>
        <div>
          <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-[#171a20]">
            Overland Mode
          </h3>
          <p class="text-neutral-600 text-sm sm:text-base font-normal mt-2.5 leading-relaxed">
            Designed for precision driving when off-roading on a variety of surfaces, from gravel to deep snow.
          </p>
        </div>
        <div>
          <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-[#171a20]">
            Wade Mode
          </h3>
          <p class="text-neutral-600 text-sm sm:text-base font-normal mt-2.5 leading-relaxed">
            Designed to help you navigate tire-high waters by raising the ride height and pressurizing the battery pack.<sup>3</sup>
          </p>
        </div>
      </div>

      <!-- Chamfered Terrain Badge Image Layout (Matching Tesla screenshot 971ec1d7) -->
      <div class="relative w-full group mt-12 sm:mt-16 md:mt-20">
        <div
          class="terrain-image-wrapper relative w-full aspect-[16/9] sm:aspect-[2.33/1] bg-neutral-900 overflow-hidden shadow-sm"
          style="clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));"
        >
          <img
            src={terrainBadgeSrc}
            alt="Tesla Cybertruck All-Terrain Capability"
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
      </div>

      <!-- 3-Stat Performance Specs Bar (Matching Tesla website) -->
      <div class="flex flex-col sm:flex-row items-start sm:items-stretch gap-8 sm:gap-0 mt-12 sm:mt-16 md:mt-20 mb-12 sm:mb-20 font-sans md:pl-[8.5vw]">
        <!-- Stat 1: 0-60 mph -->
        <div class="flex flex-col items-start pr-8 sm:pr-12 md:pr-16">
          <div class="text-[#171a20] tracking-tight flex items-baseline gap-1">
            <span class="text-4xl sm:text-5xl md:text-[52px] leading-none font-medium tracking-tight">2.6</span>
            <span class="text-xl sm:text-2xl leading-none font-normal text-[#171a20]">s</span>
          </div>
          <div class="text-[#393c41] text-xs sm:text-sm font-normal mt-2.5 tracking-tight">
            0-60 mph<sup class="text-[10px] ml-0.5">4</sup>
          </div>
        </div>

        <!-- Vertical Divider 1 -->
        <div class="hidden sm:block w-px bg-[#d0d1d2] self-stretch my-1"></div>

        <!-- Stat 2: Towing Capacity -->
        <div class="flex flex-col items-start px-8 sm:px-12 md:px-16">
          <div class="text-[#171a20] tracking-tight flex items-baseline gap-1.5">
            <span class="text-4xl sm:text-5xl md:text-[52px] leading-none font-medium tracking-tight">11,000</span>
            <span class="text-lg sm:text-xl leading-none font-normal text-[#171a20]">lbs</span>
          </div>
          <div class="text-[#393c41] text-xs sm:text-sm font-normal mt-2.5 tracking-tight">
            Towing Capacity<sup class="text-[10px] ml-0.5">3</sup>
          </div>
        </div>

        <!-- Vertical Divider 2 -->
        <div class="hidden sm:block w-px bg-[#d0d1d2] self-stretch my-1"></div>

        <!-- Stat 3: Raw Power -->
        <div class="flex flex-col items-start pl-8 sm:pl-12 md:pl-16">
          <div class="text-[#171a20] tracking-tight flex items-baseline gap-1.5">
            <span class="text-4xl sm:text-5xl md:text-[52px] leading-none font-medium tracking-tight">845</span>
            <span class="text-lg sm:text-xl leading-none font-normal text-[#171a20]">hp</span>
          </div>
          <div class="text-[#393c41] text-xs sm:text-sm font-normal mt-2.5 tracking-tight">
            Raw Power<sup class="text-[10px] ml-0.5">1</sup>
          </div>
        </div>
      </div>

      <!-- Autonomous Single Video Layout (Cybertruck Autonomous) -->
      <div class="relative w-full group mt-12 sm:mt-16 md:mt-20">
        <div
          class="autonomous-video-wrapper relative w-full aspect-[16/9] sm:aspect-[2.33/1] bg-neutral-900 overflow-hidden shadow-sm"
          style="clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));"
        >
          <video
            id="autonomous-video"
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover object-center"
          >
            <source src={autonomousVideoSrc} type="video/webm" />
          </video>

          <!-- Bottom-Left Play / Pause Button (Tesla minimalist overlay style) -->
          <button
            id="autonomous-play-pause-btn"
            class="absolute bottom-5 left-5 sm:bottom-6 sm:left-6 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-[6px] bg-black/60 hover:bg-black/80 backdrop-blur-sm text-white flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-95 border-0 shadow-none"
            aria-label="Pause or play autonomous video"
            title="Pause / Play"
          >
            <!-- Pause Icon (Default) -->
            <svg id="autonomous-pause-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white" viewBox="0 0 24 24">
              <rect x="6" y="4" width="3.5" height="16" rx="1"/>
              <rect x="14.5" y="4" width="3.5" height="16" rx="1"/>
            </svg>
            <!-- Play Icon (Hidden) -->
            <svg id="autonomous-play-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white hidden ml-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- The Future of Travel Is Autonomous Content Section (Matching Tesla screenshot) -->
      <div class="mt-12 sm:mt-16 md:mt-20 md:pl-[8.5vw]">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-[#171a20]">
          The Future of Travel Is Autonomous
        </h2>
        <div class="mt-6 sm:mt-8 space-y-6 max-w-5xl text-neutral-600 text-base sm:text-lg md:text-xl font-normal leading-relaxed">
          <p>
            Cybertruck is available with Full Self-Driving (Supervised), a suite of advanced driver-assistance features designed to provide more active guidance and assisted driving under your active supervision.
          </p>
          <p>
            Blind Spot Monitoring uses illuminated warning lights and on-screen visualizations to help you safely check your surroundings.
          </p>
        </div>
      </div>

      <!-- Safety Single Video Layout (Cybertruck Safety) -->
      <div class="relative w-full group mt-16 sm:mt-20 md:mt-24">
        <div
          class="safety-video-wrapper relative w-full aspect-[16/9] sm:aspect-[2.33/1] bg-neutral-900 overflow-hidden shadow-sm"
          style="clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));"
        >
          <video
            id="safety-video"
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover object-center"
          >
            <source src={safetyVideoSrc} type="video/webm" />
          </video>

          <!-- Bottom-Left Play / Pause Button (Tesla minimalist overlay style) -->
          <button
            id="safety-play-pause-btn"
            class="absolute bottom-5 left-5 sm:bottom-6 sm:left-6 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-[6px] bg-black/60 hover:bg-black/80 backdrop-blur-sm text-white flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-95 border-0 shadow-none"
            aria-label="Pause or play safety video"
            title="Pause / Play"
          >
            <!-- Pause Icon (Default) -->
            <svg id="safety-pause-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white" viewBox="0 0 24 24">
              <rect x="6" y="4" width="3.5" height="16" rx="1"/>
              <rect x="14.5" y="4" width="3.5" height="16" rx="1"/>
            </svg>
            <!-- Play Icon (Hidden) -->
            <svg id="safety-play-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white hidden ml-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Designed to Be the Safest Truck on the Road Content Section (Aligned to 11vw starting gutter matching horizontal carousel) -->
  <div class="w-full pl-6 md:pl-[11vw] pr-6 mt-12 sm:mt-16 md:mt-20">
    <div id="safety-text-container" class="max-w-4xl">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-[#171a20]">
        Designed to Be the Safest Truck on the Road
      </h2>
      <p class="mt-4 sm:mt-5 max-w-5xl text-neutral-600 text-base sm:text-lg md:text-xl font-normal leading-relaxed">
        With a low center of gravity, impact-absorbing castings and the lowest probability of rollover for any truck tested by NHTSA, Cybertruck has earned a five-star overall safety rating.<sup>1</sup> <a href="https://www.nhtsa.gov" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[#171a20] transition-colors">Learn More</a>
      </p>

      <!-- 5 Golden Stars & Overall NHTSA Safety Rating -->
      <div class="mt-8 sm:mt-10">
