---
// Tesla Official Mega Menu matching all screenshots exactly
---

<div
  id="mega-menu"
  class="hidden absolute top-full left-0 w-full bg-white text-[#171a20] shadow-[0_25px_50px_rgba(0,0,0,0.18)] border-t border-neutral-100 transition-all duration-200 z-50 select-none"
>
  <div class="max-w-7xl mx-auto px-10 py-10">

    <!-- 1. VEHICLES PANEL -->
    <div id="panel-vehicles" class="mega-panel hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Product Grid -->
        <div class="lg:col-span-9 space-y-6">
          <!-- Row 1 -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            <!-- Model 3 -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Vehicles-Model-3-LHD.png"
                  alt="Model 3"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-base text-[#171a20]">Model 3</h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="https://www.tesla.com/model3" class="underline hover:text-black">Learn</a>
                <a href="https://www.tesla.com/model3/design" class="underline hover:text-black">Order</a>
              </div>
            </div>

            <!-- Model Y -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Vehicles-Model-Y.png"
                  alt="Model Y"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-base text-[#171a20]">Model Y</h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="https://www.tesla.com/modely" class="underline hover:text-black">Learn</a>
                <a href="https://www.tesla.com/modely/design" class="underline hover:text-black">Order</a>
              </div>
            </div>

            <!-- Cybertruck -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Vehicles-Cybertruck-1x.png"
                  alt="Cybertruck"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-base text-[#171a20]">Cybertruck</h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="#hero" class="underline hover:text-black">Learn</a>
                <a href="#order" class="underline hover:text-black">Order</a>
              </div>
            </div>

            <!-- Roadster -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Roadster.png"
                  alt="Roadster"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-base text-[#171a20]">Roadster</h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="https://www.tesla.com/roadster" class="underline hover:text-black">Learn</a>
                <a href="https://www.tesla.com/roadster/reserve" class="underline hover:text-black">Reserve</a>
              </div>
            </div>
          </div>

          <!-- Row 2 -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-2">
            <!-- Full Self-Driving -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Vehicles-FSD.png"
                  alt="Full Self-Driving"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-sm text-[#171a20] leading-tight">Full Self-Driving<br/><span class="text-xs font-normal text-neutral-500">(Supervised)</span></h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="#" class="underline hover:text-black">Learn</a>
                <a href="#" class="underline hover:text-black">Experience</a>
              </div>
            </div>

            <!-- Inventory -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Vehicles-Inventory.png"
                  alt="Inventory"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-sm text-[#171a20]">Inventory</h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="#" class="underline hover:text-black">New</a>
                <a href="#" class="underline hover:text-black">Certified Pre-Owned</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side Nav Links List -->
        <div class="lg:col-span-3 border-l border-neutral-200 pl-8 space-y-2.5 text-sm font-semibold text-[#171a20]">
          <div><a href="#" class="hover:underline">Current Offers</a></div>
          <div><button class="open-demo-drive-action hover:underline text-left">Demo Drive</button></div>
          <div><a href="#" class="hover:underline">Trade-In</a></div>
          <div><a href="#" class="hover:underline">Vehicle Safety Report</a></div>
          <div><a href="#" class="hover:underline">Certified Pre-Owned</a></div>
          <div><a href="#" class="hover:underline">Trip Planner</a></div>
          <div><a href="#" class="hover:underline">Features</a></div>
          <div><a href="#" class="hover:underline">Help Me Choose</a></div>
          <div><a href="#specs" class="hover:underline">Compare</a></div>
          <div><a href="#" class="hover:underline">Safety</a></div>
          <div><a href="#" class="hover:underline">Fleet</a></div>
          <div><a href="https://www.tesla.com/models" class="hover:underline">Model S</a></div>
          <div><a href="https://www.tesla.com/modelx" class="hover:underline">Model X</a></div>
        </div>
      </div>
    </div>

    <!-- 2. ENERGY PANEL -->
    <div id="panel-energy" class="mega-panel hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-9 grid grid-cols-2 sm:grid-cols-3 gap-8">
          <!-- Solar Panels -->
          <div class="group text-center cursor-pointer">
            <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
              <img
                src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Energy-Solar-Panels.png"
                alt="Solar Panels"
                class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <h4 class="font-bold text-base text-[#171a20]">Solar Panels</h4>
            <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
              <a href="#" class="underline hover:text-black">Learn</a>
              <a href="#" class="underline hover:text-black">Order</a>
            </div>
          </div>

          <!-- Powerwall -->
          <div class="group text-center cursor-pointer">
            <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
              <img
                src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Energy-Powerwall-US.png"
                alt="Powerwall"
                class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <h4 class="font-bold text-base text-[#171a20]">Powerwall</h4>
            <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
              <a href="#" class="underline hover:text-black">Learn</a>
              <a href="#" class="underline hover:text-black">Order</a>
            </div>
          </div>

          <!-- Megapack -->
          <div class="group text-center cursor-pointer">
            <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
              <img
                src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Energy-Megapack.png"
                alt="Megapack"
                class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <h4 class="font-bold text-base text-[#171a20]">Megapack</h4>
            <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
              <a href="#" class="underline hover:text-black">Learn</a>
            </div>
          </div>
        </div>

        <!-- Right Side Nav Links List -->
        <div class="lg:col-span-3 border-l border-neutral-200 pl-8 space-y-2.5 text-sm font-semibold text-[#171a20]">
          <div><a href="#" class="hover:underline">Schedule a Consultation</a></div>
          <div><a href="#" class="hover:underline">Tesla Home</a></div>
          <div><a href="#" class="hover:underline">Why Solar</a></div>
          <div><a href="#" class="hover:underline">Incentives</a></div>
          <div><a href="#" class="hover:underline">Support</a></div>
          <div><a href="#" class="hover:underline">Partner with Tesla</a></div>
          <div><a href="#" class="hover:underline">Commercial</a></div>
          <div><a href="#" class="hover:underline">Utilities</a></div>
        </div>
      </div>
    </div>

    <!-- 3. CHARGING PANEL -->
    <div id="panel-charging" class="mega-panel hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-9 space-y-6">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            <!-- Charging -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Charging-Charging.png"
                  alt="Charging"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-base text-[#171a20]">Charging</h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="#" class="underline hover:text-black">Learn</a>
              </div>
            </div>

            <!-- Home Charging -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Charging-Home-Charging.png"
                  alt="Home Charging"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-base text-[#171a20]">Home Charging</h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="#" class="underline hover:text-black">Learn</a>
                <a href="#" class="underline hover:text-black">Shop</a>
              </div>
            </div>

            <!-- Supercharging -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Charging-Supercharging.png"
                  alt="Supercharging"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-base text-[#171a20]">Supercharging</h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="#" class="underline hover:text-black">Learn</a>
                <a href="#" class="underline hover:text-black">Find</a>
              </div>
            </div>

            <!-- Wall Connector for Business -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Charging-Home-Charging.png"
                  alt="Wall Connector for Business"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-sm text-[#171a20] leading-tight">Wall Connector<br/><span class="text-xs">for Business</span></h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="#" class="underline hover:text-black">Learn</a>
                <a href="#" class="underline hover:text-black">Order</a>
              </div>
            </div>
          </div>

          <!-- Row 2 -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-2">
            <!-- Supercharger for Business -->
            <div class="group text-center cursor-pointer">
              <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
                <img
                  src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Charging-Supercharger-for-Business.png"
                  alt="Supercharger for Business"
                  class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-sm text-[#171a20] leading-tight">Supercharger<br/><span class="text-xs">for Business</span></h4>
              <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
                <a href="#" class="underline hover:text-black">Learn</a>
                <a href="#" class="underline hover:text-black">Order</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side Nav Links List -->
        <div class="lg:col-span-3 border-l border-neutral-200 pl-8 space-y-2.5 text-sm font-semibold text-[#171a20]">
          <div><a href="#" class="hover:underline">Help Me Charge</a></div>
          <div><a href="#" class="hover:underline">Charging Calculator</a></div>
          <div><a href="#" class="hover:underline">Charging With NACS</a></div>
          <div><a href="#" class="hover:underline">Supercharger Voting</a></div>
          <div><a href="#" class="hover:underline">Host a Supercharger</a></div>
          <div><a href="#powershare" class="hover:underline">Powershare</a></div>
        </div>
      </div>
    </div>

    <!-- 4. ROBOTAXI PANEL -->
    <div id="panel-robotaxi" class="mega-panel hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-9 flex items-center">
          <div class="group text-center cursor-pointer max-w-xs mx-auto">
            <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
              <img
                src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Robotaxi.png"
                alt="Robotaxi"
                class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <h4 class="font-bold text-base text-[#171a20]">Robotaxi</h4>
            <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
              <a href="#" class="underline hover:text-black">Learn</a>
            </div>
          </div>
        </div>

        <div class="lg:col-span-3 border-l border-neutral-200 pl-8 space-y-2.5 text-sm font-semibold text-[#171a20]">
          <div><a href="#" class="hover:underline">Safety</a></div>
          <div><a href="#" class="hover:underline">First Responders</a></div>
          <div><a href="#" class="hover:underline">Support</a></div>
        </div>
      </div>
    </div>

    <!-- 5. SEMI PANEL (Exact match to Screenshot 1) -->
    <div id="panel-semi" class="mega-panel hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Product Grid -->
        <div class="lg:col-span-9 grid grid-cols-1 sm:grid-cols-2 gap-12 max-w-xl mx-auto items-center">
          <!-- Semi -->
          <div class="group text-center cursor-pointer">
            <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
              <img
                src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Semi.png"
                alt="Semi"
                class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <h4 class="font-bold text-base text-[#171a20]">Semi</h4>
            <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
              <a href="#" class="underline hover:text-black">Learn</a>
            </div>
          </div>

          <!-- Semi Charging for Business -->
          <div class="group text-center cursor-pointer">
            <div class="aspect-[16/10] flex items-center justify-center overflow-hidden mb-2">
              <img
                src={`${import.meta.env.BASE_URL}semi-charging-business.png`}
                alt="Semi Charging for Business"
                class="w-full max-w-[220px] h-auto object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <h4 class="font-bold text-sm text-[#171a20] leading-tight mt-1">Semi Charging for<br/>Business</h4>
            <div class="flex items-center justify-center gap-3 text-xs text-neutral-500 mt-1">
              <a href="#" class="underline hover:text-black">Learn</a>
              <a href="#" class="underline hover:text-black">Order</a>
            </div>
          </div>
        </div>

        <!-- Right Side Nav Links List (Exact from Screenshot 1) -->
        <div class="lg:col-span-3 border-l border-neutral-200 pl-8 space-y-2.5 text-sm font-semibold text-[#171a20]">
          <div><a href="#" class="hover:underline">Find Us</a></div>
          <div><a href="#" class="hover:underline">Tesla for Business</a></div>
        </div>
      </div>
    </div>

    <!-- 6. DISCOVER PANEL (Exact match to Screenshot 2) -->
    <div id="panel-discover" class="mega-panel hidden">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 max-w-4xl mx-auto py-4">
        <!-- Column 1: Resources -->
        <div>
          <h5 class="text-xs font-medium text-neutral-500 mb-4">Resources</h5>
          <ul class="space-y-3 text-sm font-semibold text-[#171a20]">
            <li><button class="open-demo-drive-action hover:underline text-left">Demo Drive</button></li>
            <li><a href="#" class="hover:underline">Insurance</a></li>
            <li><a href="#" class="hover:underline">Current Offers</a></li>
            <li><a href="#" class="hover:underline">Learn</a></li>
            <li><a href="#" class="hover:underline">Video Guides</a></li>
            <li><a href="#" class="hover:underline">Customer Stories</a></li>
            <li><a href="#" class="hover:underline">Events</a></li>
            <li><a href="#" class="hover:underline">Safety</a></li>
          </ul>
        </div>

        <!-- Column 2: Location Services -->
        <div>
          <h5 class="text-xs font-medium text-neutral-500 mb-4">Location Services</h5>
          <ul class="space-y-3 text-sm font-semibold text-[#171a20]">
            <li><a href="#" class="hover:underline">Find Us</a></li>
            <li><a href="#" class="hover:underline">Find a Collision Center</a></li>
            <li><a href="#" class="hover:underline">Find a Certified Installer</a></li>
          </ul>
        </div>

        <!-- Column 3: Company -->
        <div>
          <h5 class="text-xs font-medium text-neutral-500 mb-4">Company</h5>
          <ul class="space-y-3 text-sm font-semibold text-[#171a20]">
            <li><a href="#" class="hover:underline">About</a></li>
            <li><a href="#" class="hover:underline">Careers</a></li>
            <li><a href="#" class="hover:underline">Investor Relations</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 7. SHOP PANEL (Exact match to Screenshot 3) -->
    <div id="panel-shop" class="mega-panel hidden">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 max-w-5xl mx-auto items-center py-2">
        <!-- 1: Charging -->
        <div class="group text-center cursor-pointer">
          <div class="aspect-square flex items-center justify-center overflow-hidden mb-3">
            <img
              src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Shop-Charging.png"
