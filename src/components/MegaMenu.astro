        <!-- 2: Vehicle Accessories -->
        <div class="group text-center cursor-pointer">
          <div class="aspect-square flex items-center justify-center overflow-hidden mb-3">
            <img
              src="https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Mega-Menu-Shop-Vehicle-Accessories.png"
