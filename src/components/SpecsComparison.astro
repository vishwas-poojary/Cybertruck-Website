---
// Comprehensive Specifications Comparison Table & Detailed Engineering Specs
---

<section id="specs" class="relative py-28 px-6 md:px-12 bg-black border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs uppercase font-mono tracking-widest text-neutral-400 font-semibold mb-2 block">
        // TECHNICAL COMPARISON
      </span>
      <h2 class="font-['Blender_TSL',-apple-system,Arial,sans-serif] font-black text-3xl sm:text-5xl text-white tracking-wide uppercase leading-tight">
        CYBERTRUCK SPECIFICATIONS
      </h2>
      <p class="text-neutral-400 mt-4 text-base sm:text-lg">
        Compare powertrain configurations, capabilities, dimensions, and standard equipment across the Cybertruck lineup.
      </p>
    </div>

    <!-- Trim Comparison Table -->
    <div class="rounded-2xl border border-white/10 bg-neutral-950 overflow-hidden shadow-2xl">
      <!-- Table Header -->
      <div class="grid grid-cols-1 md:grid-cols-4 border-b border-white/10 text-center font-['Blender_TSL',-apple-system,Arial,sans-serif]">
        <div class="hidden md:flex items-center px-6 py-5 text-left text-neutral-400 text-sm uppercase font-mono">
          Specification
        </div>
        <div class="p-6 border-b md:border-b-0 md:border-l border-white/10 bg-red-950/20">
          <div class="text-red-500 font-mono text-xs uppercase mb-1">Top-Tier Tri-Motor</div>
          <h3 class="text-2xl font-black text-white">CYBERBEAST</h3>
          <div class="text-lg font-bold text-neutral-200 mt-1 font-mono">$99,990</div>
        </div>
        <div class="p-6 border-b md:border-b-0 md:border-l border-white/10">
          <div class="text-neutral-400 font-mono text-xs uppercase mb-1">Dual-Motor</div>
          <h3 class="text-2xl font-black text-white">ALL-WHEEL DRIVE</h3>
          <div class="text-lg font-bold text-neutral-200 mt-1 font-mono">$79,990</div>
        </div>
        <div class="p-6 md:border-l border-white/10">
          <div class="text-neutral-400 font-mono text-xs uppercase mb-1">Single Motor</div>
          <h3 class="text-2xl font-black text-white">REAR-WHEEL DRIVE</h3>
          <div class="text-lg font-bold text-neutral-200 mt-1 font-mono">$60,990</div>
        </div>
      </div>

      <!-- Specs Rows -->
      <div class="divide-y divide-white/5 text-sm">
        <!-- Acceleration -->
        <div class="grid grid-cols-1 md:grid-cols-4 p-4 md:px-6 items-center hover:bg-white/[0.02] transition-colors">
          <div class="font-mono text-xs text-neutral-400 uppercase mb-1 md:mb-0">0-60 MPH Acceleration</div>
          <div class="text-center font-bold text-white md:border-l border-white/5 py-1">2.6 sec (Beast Mode)</div>
          <div class="text-center font-semibold text-neutral-300 md:border-l border-white/5 py-1">4.1 sec</div>
          <div class="text-center text-neutral-400 md:border-l border-white/5 py-1">6.5 sec</div>
        </div>

        <!-- Range -->
        <div class="grid grid-cols-1 md:grid-cols-4 p-4 md:px-6 items-center hover:bg-white/[0.02] transition-colors">
          <div class="font-mono text-xs text-neutral-400 uppercase mb-1 md:mb-0">Range (EPA Est.)</div>
          <div class="text-center font-bold text-white md:border-l border-white/5 py-1">320 mi (440+ with Extender)</div>
          <div class="text-center font-semibold text-neutral-300 md:border-l border-white/5 py-1">340 mi (470+ with Extender)</div>
          <div class="text-center text-neutral-400 md:border-l border-white/5 py-1">250 mi est.</div>
        </div>

        <!-- Towing Capacity -->
        <div class="grid grid-cols-1 md:grid-cols-4 p-4 md:px-6 items-center hover:bg-white/[0.02] transition-colors">
          <div class="font-mono text-xs text-neutral-400 uppercase mb-1 md:mb-0">Towing Capacity</div>
          <div class="text-center font-bold text-white md:border-l border-white/5 py-1">11,000 lbs</div>
          <div class="text-center font-semibold text-neutral-300 md:border-l border-white/5 py-1">11,000 lbs</div>
          <div class="text-center text-neutral-400 md:border-l border-white/5 py-1">7,500 lbs</div>
        </div>

        <!-- Horsepower & Motors -->
        <div class="grid grid-cols-1 md:grid-cols-4 p-4 md:px-6 items-center hover:bg-white/[0.02] transition-colors">
          <div class="font-mono text-xs text-neutral-400 uppercase mb-1 md:mb-0">Drivetrain & Power</div>
          <div class="text-center font-bold text-white md:border-l border-white/5 py-1">845 HP (Tri-Motor AWD)</div>
          <div class="text-center font-semibold text-neutral-300 md:border-l border-white/5 py-1">600 HP (Dual-Motor AWD)</div>
          <div class="text-center text-neutral-400 md:border-l border-white/5 py-1">Single Motor RWD</div>
        </div>

        <!-- Top Speed -->
        <div class="grid grid-cols-1 md:grid-cols-4 p-4 md:px-6 items-center hover:bg-white/[0.02] transition-colors">
          <div class="font-mono text-xs text-neutral-400 uppercase mb-1 md:mb-0">Top Speed</div>
          <div class="text-center font-bold text-white md:border-l border-white/5 py-1">130 mph</div>
          <div class="text-center font-semibold text-neutral-300 md:border-l border-white/5 py-1">112 mph</div>
          <div class="text-center text-neutral-400 md:border-l border-white/5 py-1">112 mph</div>
        </div>

        <!-- Weight -->
        <div class="grid grid-cols-1 md:grid-cols-4 p-4 md:px-6 items-center hover:bg-white/[0.02] transition-colors">
          <div class="font-mono text-xs text-neutral-400 uppercase mb-1 md:mb-0">Curb Weight</div>
          <div class="text-center font-bold text-white md:border-l border-white/5 py-1">6,843 lbs</div>
          <div class="text-center font-semibold text-neutral-300 md:border-l border-white/5 py-1">6,603 lbs</div>
          <div class="text-center text-neutral-400 md:border-l border-white/5 py-1">6,100 lbs est.</div>
        </div>

        <!-- Steering & Suspension -->
        <div class="grid grid-cols-1 md:grid-cols-4 p-4 md:px-6 items-center hover:bg-white/[0.02] transition-colors">
          <div class="font-mono text-xs text-neutral-400 uppercase mb-1 md:mb-0">Steering & Suspension</div>
          <div class="text-center font-bold text-white md:border-l border-white/5 py-1">Steer-by-Wire & 4-Wheel Steering</div>
          <div class="text-center font-semibold text-neutral-300 md:border-l border-white/5 py-1">Steer-by-Wire & 4-Wheel Steering</div>
          <div class="text-center text-neutral-400 md:border-l border-white/5 py-1">Rear-Wheel Steering</div>
        </div>

        <!-- Bed & Cargo Volume -->
        <div class="grid grid-cols-1 md:grid-cols-4 p-4 md:px-6 items-center hover:bg-white/[0.02] transition-colors">
          <div class="font-mono text-xs text-neutral-400 uppercase mb-1 md:mb-0">Bed Dimensions & Storage</div>
          <div class="text-center font-bold text-white md:border-l border-white/5 py-1">6' x 4' Bed | 120 cu ft Storage</div>
          <div class="text-center font-semibold text-neutral-300 md:border-l border-white/5 py-1">6' x 4' Bed | 120 cu ft Storage</div>
          <div class="text-center text-neutral-400 md:border-l border-white/5 py-1">6' x 4' Bed | 120 cu ft Storage</div>
        </div>
      </div>

      <!-- Action Row -->
      <div class="grid grid-cols-1 md:grid-cols-4 p-6 bg-neutral-900/40 border-t border-white/10 items-center">
        <div class="text-xs text-neutral-400 font-mono mb-4 md:mb-0">
          Ready to configure?
        </div>
        <div class="text-center md:border-l border-white/10 px-4">
          <a href="#order" class="block w-full py-2.5 rounded bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wider transition-all">
            Order Cyberbeast
          </a>
        </div>
        <div class="text-center md:border-l border-white/10 px-4 my-2 md:my-0">
          <a href="#order" class="block w-full py-2.5 rounded bg-white hover:bg-neutral-200 text-black font-bold text-xs uppercase tracking-wider transition-all">
            Order All-Wheel Drive
          </a>
        </div>
        <div class="text-center md:border-l border-white/10 px-4">
          <a href="#order" class="block w-full py-2.5 rounded border border-white/20 hover:border-white text-white font-semibold text-xs uppercase tracking-wider transition-all">
            Reserve RWD
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

