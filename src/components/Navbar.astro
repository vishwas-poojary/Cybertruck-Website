---
import TopBanner from './TopBanner.astro';
import MegaMenu from './MegaMenu.astro';
---

<header id="site-header" class="fixed top-0 left-0 w-full z-40 transition-colors duration-200">
  <!-- Gold Top Promotional Banner (Screenshot 1) -->
  <TopBanner />

  <!-- Top Global Tesla Bar (Active at Hero section) -->
  <nav
    id="main-nav"
    class="w-full px-6 md:px-10 py-3 flex items-center justify-between text-sm transition-all duration-300 ease-in-out text-white overflow-hidden max-h-16 opacity-100"
  >
    <!-- Tesla Official Wordmark Logo (Matching uploaded logo vector) -->
    <a href={import.meta.env.BASE_URL} class="flex items-center group py-1" aria-label="Tesla Cybertruck Home">
      <svg id="tesla-logo" class="h-3 sm:h-3.5 w-auto fill-current transition-colors duration-200" viewBox="0 0 342 35" xmlns="http://www.w3.org/2000/svg" aria-label="Tesla Logo">
        <path d="M0 .1a9.7 9.7 0 0 0 7 7h11l.5.1v27.6h6.8V7.3L26 7h11a9.8 9.8 0 0 0 7-7H0zm238.6 0h-6.8v34.8H263a9.7 9.7 0 0 0 6-6.8h-30.3V0zm-52.3 6.8c3.6-1 6.6-3.8 7.4-6.9l-38.1.1v20.6h31.1v7.2h-24.4a13.6 13.6 0 0 0-8.7 7h39.9v-21h-31.2v-7h24zm116.2 28h6.7v-14h24.6v14h6.7v-21h-38zM85.3 7h26a9.6 9.6 0 0 0 7.1-7H78.3a9.6 9.6 0 0 0 7 7zm0 13.8h26a9.6 9.6 0 0 0 7.1-7H78.3a9.6 9.6 0 0 0 7 7zm0 14.1h26a9.6 9.6 0 0 0 7.1-7H78.3a9.6 9.6 0 0 0 7 7zM308.5 7h26a9.6 9.6 0 0 0 7-7h-40a9.6 9.6 0 0 0 7 7z"></path>
      </svg>
    </a>

    <!-- Center Navigation Links (Matching Screenshots 1, 2, 3) -->
    <div class="hidden lg:flex items-center gap-1 font-semibold text-[13.5px] tracking-tight">
      <button class="nav-item px-3.5 py-1.5 rounded transition-all" data-panel="panel-vehicles">
        Vehicles
      </button>
      <button class="nav-item px-3.5 py-1.5 rounded transition-all" data-panel="panel-energy">
        Energy
      </button>
      <button class="nav-item px-3.5 py-1.5 rounded transition-all" data-panel="panel-charging">
        Charging
      </button>
      <button class="nav-item px-3.5 py-1.5 rounded transition-all" data-panel="panel-robotaxi">
        Robotaxi
      </button>
      <button class="nav-item px-3.5 py-1.5 rounded transition-all" data-panel="panel-semi">
        Semi
      </button>
      <button class="nav-item px-3.5 py-1.5 rounded transition-all" data-panel="panel-discover">
        Discover
      </button>
      <button class="nav-item px-3.5 py-1.5 rounded transition-all" data-panel="panel-shop">
        Shop
      </button>
    </div>

    <!-- Right Controls Icons (Matching Screenshots) -->
    <div class="flex items-center gap-1 sm:gap-2">
      <!-- Help / Question circle icon (?) -->
      <a href="#adventure" class="nav-icon p-2 hover:bg-black/10 rounded-full transition-all" title="Help & Support" aria-label="Support">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <circle cx="12" cy="17" r="0.8" fill="currentColor"/>
        </svg>
      </a>

      <!-- Region / Globe icon -->
      <button class="nav-icon p-2 hover:bg-black/10 rounded-full transition-all" title="Region & Language" aria-label="Region selector">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
          <path stroke-width="1.8" d="M2.5 12h19M12 2.5a15 15 0 0 1 4 9.5 15 15 0 0 1-4 9.5 15 15 0 0 1-4-9.5 15 15 0 0 1 4-9.5z"/>
        </svg>
      </button>

      <!-- Account circle icon -->
      <a href="#order" class="nav-icon p-2 hover:bg-black/10 rounded-full transition-all" title="Tesla Account" aria-label="Account">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
          <circle cx="12" cy="10" r="3" stroke-width="1.8"/>
          <path stroke-width="1.8" d="M6.168 18.849A4 4 0 0 1 10 16h4a4 4 0 0 1 3.834 2.855"/>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button class="mobile-menu-btn lg:hidden p-2 hover:bg-black/10 rounded transition-all" aria-label="Toggle navigation menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Sticky Cybertruck Sub-Navigation Bar (Semi-transparent with backdrop blur to dynamically reflect underlying colors matching real Tesla website) -->
  <div
    id="sub-nav"
    class="w-full bg-[#181a1f]/35 backdrop-blur-md px-6 md:px-12 flex items-center justify-between text-xs sm:text-[13px] transition-all duration-300 ease-in-out text-white overflow-hidden max-h-0 opacity-0 pointer-events-none -translate-y-2 py-0 border-0 shadow-none"
  >
    <a href="#hero" class="flex items-center gap-2 group py-0.5">
      <span class="font-medium text-sm sm:text-base text-white tracking-tight">
        Cybertruck
      </span>
    </a>

    <div class="flex items-center gap-4 sm:gap-6 font-medium">
      <a href="#specs" class="text-white hover:text-white/80 transition-colors">Compare Models</a>
      <a href="#order" class="hidden sm:inline-block text-white hover:text-white/80 transition-colors">View Inventory</a>
      <a
        href="#order"
        class="px-4 py-1.5 rounded-[4px] bg-[#222222] hover:bg-[#171a20] text-white font-medium transition-all text-xs shadow-none border-0 active:scale-[0.98]"
      >
        Order Now
      </a>
      <button class="mobile-menu-btn lg:hidden p-1.5 text-white hover:text-white/80 transition-colors" aria-label="Toggle navigation menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mega Menu Dropdown -->
  <MegaMenu />
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-drawer" class="fixed inset-0 bg-black/95 backdrop-blur-2xl z-50 hidden flex-col justify-between p-8 text-neutral-200 transition-all duration-300">
  <div>
    <div class="flex items-center justify-between pb-6 border-b border-white/10">
      <span class="font-['Chakra_Petch',sans-serif] font-bold text-lg tracking-wider text-white">CYBERTRUCK</span>
      <button id="close-mobile-menu" class="p-2 text-neutral-400 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="flex flex-col gap-4 mt-6 text-base font-medium">
      <a href="#hero" class="mobile-link text-white font-bold">Home</a>
      <a href="#adventure" class="mobile-link hover:text-white">Adventure & Clearance</a>
      <a href="#exoskeleton" class="mobile-link hover:text-white">Exoskeleton Body</a>
      <a href="#armor-glass" class="mobile-link hover:text-white">Armor Glass Impact</a>
      <a href="#vault" class="mobile-link hover:text-white">The Vault & Bed</a>
      <a href="#powershare" class="mobile-link hover:text-white">PowerShare Outlets</a>
      <a href="#interior" class="mobile-link hover:text-white">Cyber Cabin Interior</a>
      <a href="#performance" class="mobile-link hover:text-white">Beast Mode 0-60</a>
      <a href="#specs" class="mobile-link hover:text-white">Specifications</a>
      <a href="#accessories" class="mobile-link hover:text-white">Accessories</a>
      <a href="#order" class="mobile-link text-white font-bold">Custom Order Studio</a>
    </div>
  </div>

  <div class="flex flex-col gap-3 pt-6 border-t border-white/10">
    <a href="#order" class="w-full py-3 text-center bg-[#3e6ae1] text-white font-bold rounded">
      Order Now
    </a>
    <button class="open-demo-drive-action w-full py-3 text-center border border-white/20 text-white font-medium rounded hover:bg-white/10">
      Schedule Demo Drive
    </button>
  </div>
</div>

<script>
  import { playCyberClick } from '../utils/cyberSound';

  const siteHeader = document.getElementById('site-header');
  const mainNav = document.getElementById('main-nav');
  const megaMenu = document.getElementById('mega-menu');
  const navItems = document.querySelectorAll('.nav-item');
  const panels = document.querySelectorAll('.mega-panel');
  const subNav = document.getElementById('sub-nav');

  function showMegaMenu(panelId: string, currentBtn: Element) {
    if (!megaMenu || !mainNav) return;

    // Open mega menu container
    megaMenu.classList.remove('hidden');

    // Show only the targeted panel
    panels.forEach((p) => {
      if (p.id === panelId) {
        p.classList.remove('hidden');
      } else {
        p.classList.add('hidden');
      }
    });

    // Style active button with the soft grey rounded pill from the screenshots
    navItems.forEach((btn) => {
      btn.classList.remove('bg-[#0000000d]', 'text-[#171a20]');
    });
    currentBtn.classList.add('bg-[#0000000d]', 'text-[#171a20]');

    // Switch Navbar to white background with dark text
    mainNav.classList.remove('text-white');
    mainNav.classList.add('bg-white', 'text-[#171a20]');
  }

  function hideMegaMenu() {
    if (!megaMenu || !mainNav) return;

    // Hide mega menu
    megaMenu.classList.add('hidden');
    panels.forEach((p) => p.classList.add('hidden'));

    // Reset nav buttons
    navItems.forEach((btn) => {
      btn.classList.remove('bg-[#0000000d]', 'text-[#171a20]');
    });

    // Return navbar to transparent with white text over hero
    mainNav.classList.remove('bg-white', 'text-[#171a20]');
    mainNav.classList.add('text-white');
  }

  // Hover listeners on nav items
  navItems.forEach((btn) => {
    btn.addEventListener('mouseenter', () => {
      const panelId = btn.getAttribute('data-panel');
      if (panelId) {
        showMegaMenu(panelId, btn);
      }
    });
  });

  // Keep menu open when hovering within siteHeader; close when leaving
  siteHeader?.addEventListener('mouseleave', () => {
    hideMegaMenu();
  });

  // Sticky transition: Switch from main nav to Cybertruck sub-nav when scrolling past Hero
  function updateNavbarsOnScroll() {
    if (!mainNav || !subNav) return;
    const scrollY = window.scrollY;

    // Transition threshold (scrolling away from the hero)
    if (scrollY > 200) {
      // Past Hero: Smoothly hide global main-nav and reveal Cybertruck sub-nav
      hideMegaMenu();
      mainNav.classList.remove('max-h-16', 'opacity-100', 'py-3');
      mainNav.classList.add('max-h-0', 'opacity-0', 'pointer-events-none', '-translate-y-2', 'py-0');

      subNav.classList.remove('max-h-0', 'opacity-0', 'pointer-events-none', '-translate-y-2', 'py-0');
      subNav.classList.add('max-h-16', 'opacity-100', 'pointer-events-auto', 'translate-y-0', 'py-2.5');
    } else {
      // At Hero: Show global main-nav and hide Cybertruck sub-nav
      mainNav.classList.remove('max-h-0', 'opacity-0', 'pointer-events-none', '-translate-y-2', 'py-0');
      mainNav.classList.add('max-h-16', 'opacity-100', 'py-3');

      subNav.classList.remove('max-h-16', 'opacity-100', 'pointer-events-auto', 'translate-y-0', 'py-2.5');
      subNav.classList.add('max-h-0', 'opacity-0', 'pointer-events-none', '-translate-y-2', 'py-0');
    }
  }

  window.addEventListener('scroll', updateNavbarsOnScroll, { passive: true });
  // Initial check on load in case page is refreshed while scrolled
  updateNavbarsOnScroll();

  // Mobile drawer controls (wired to both main-nav and sub-nav mobile buttons)
  const mobileMenuBtns = document.querySelectorAll('.mobile-menu-btn');
  const closeMobileMenu = document.getElementById('close-mobile-menu');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  mobileMenuBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      mobileDrawer?.classList.remove('hidden');
      mobileDrawer?.classList.add('flex');
      playCyberClick();
    });
  });

  closeMobileMenu?.addEventListener('click', () => {
    mobileDrawer?.classList.add('hidden');
    mobileDrawer?.classList.remove('flex');
    playCyberClick();
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileDrawer?.classList.add('hidden');
      mobileDrawer?.classList.remove('flex');
    });
  });
</script>
