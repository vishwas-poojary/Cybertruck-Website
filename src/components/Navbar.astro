---
import MegaMenu from './MegaMenu.astro';
---

<header id="site-header" class="fixed top-0 left-0 w-full z-50 transition-all duration-300">
  <!-- Top Global Tesla Bar -->
  <nav class="w-full bg-[#08090a]/80 backdrop-blur-md border-b border-white/5 px-6 md:px-12 py-3.5 flex items-center justify-between text-sm transition-all duration-300" id="main-nav">
    <!-- Tesla Logo -->
    <a href={import.meta.env.BASE_URL} class="flex items-center text-white hover:opacity-80 transition-opacity" aria-label="Tesla Cybertruck Home">
      <svg class="h-4 w-auto fill-current tracking-widest" viewBox="0 0 342 35" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 .1a9.7 9.7 0 0 0 7 7h11L0 24.2l5.7 3.3L19 14.2V35h6.6V14.2l8.2 13.3 5.8-3.3L21.3 7.1h11a9.7 9.7 0 0 0 7-7H0z"/>
        <path d="M38.8 7.1h39.7v5.5H38.8zM42.7 17.8h31.9v5.5H42.7zM38.8 28.5h39.7V34H38.8z"/>
        <path d="M92.7 7.1h40.4v5.5H92.7zM92.7 17.8h40.4v5.5H92.7zM92.7 28.5h40.4V34H92.7z"/>
        <path d="M147.2 7.1h40.4v5.5h-40.4zM147.2 17.8h40.4v5.5h-40.4zM147.2 28.5h40.4V34h-40.4z"/>
        <path d="M201.8 7.1h40.4v26.9h-40.4z"/>
        <path d="M256.3 7.1h40.4v5.5h-40.4zM256.3 17.8h40.4v5.5h-40.4zM256.3 28.5h40.4V34h-40.4z"/>
      </svg>
    </a>

    <!-- Center Navigation Links (Desktop) -->
    <div class="hidden lg:flex items-center gap-1 font-medium text-neutral-300 text-[13px]">
      <button class="nav-item px-3.5 py-1.5 rounded hover:bg-white/10 hover:text-white transition-all" data-panel="panel-vehicles">
        Vehicles
      </button>
      <button class="nav-item px-3.5 py-1.5 rounded hover:bg-white/10 hover:text-white transition-all" data-panel="panel-energy">
        Energy
      </button>
      <button class="nav-item px-3.5 py-1.5 rounded hover:bg-white/10 hover:text-white transition-all" data-panel="panel-charging">
        Charging
      </button>
      <a href="#adventure" class="px-3.5 py-1.5 rounded hover:bg-white/10 hover:text-white transition-all">
        Discover
      </a>
      <a href="#accessories" class="px-3.5 py-1.5 rounded hover:bg-white/10 hover:text-white transition-all">
        Shop
      </a>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2">
      <!-- Demo Drive Quick Action -->
      <button id="open-demo-drive-top" class="hidden sm:inline-flex items-center px-3.5 py-1 rounded text-xs font-semibold bg-white/10 hover:bg-white/20 border border-white/10 text-white transition-all">
        Schedule Drive
      </button>

      <!-- Region / Globe -->
      <button class="p-2 text-neutral-400 hover:text-white hover:bg-white/5 rounded-full transition-all" title="Region / Language" aria-label="Region selector">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="1.8"/>
          <path stroke-width="1.8" d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
      </button>

      <!-- Account Icon -->
      <a href="#order" class="p-2 text-neutral-400 hover:text-white hover:bg-white/5 rounded-full transition-all" title="Tesla Account" aria-label="Account">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-neutral-300 hover:text-white rounded hover:bg-white/10 transition-all" aria-label="Toggle navigation menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Cybertruck Sub-Navigation (Sticky Secondary Header) -->
  <div id="sub-nav" class="w-full bg-[#0a0b0d]/90 backdrop-blur-xl border-b border-white/10 px-6 md:px-12 py-2.5 flex items-center justify-between text-xs transition-all duration-300 shadow-lg">
    <!-- Cybertruck Monogram Title -->
    <a href="#" class="flex items-center gap-2 group">
      <span class="font-['Chakra_Petch',sans-serif] font-extrabold text-sm tracking-widest text-neutral-100 uppercase group-hover:text-red-500 transition-colors">
        CYBERTRUCK
      </span>
      <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400 border border-neutral-700">
        AWD / Beast
      </span>
    </a>

    <!-- Sticky Section Nav Anchors (Desktop) -->
    <div class="hidden xl:flex items-center gap-5 text-neutral-400 font-medium tracking-wide">
      <a href="#adventure" class="hover:text-white transition-colors">Adventure</a>
      <a href="#exoskeleton" class="hover:text-white transition-colors">Exoskeleton</a>
      <a href="#armor-glass" class="hover:text-white transition-colors">Armor Glass</a>
      <a href="#vault" class="hover:text-white transition-colors">Vault</a>
      <a href="#powershare" class="hover:text-white transition-colors">PowerShare</a>
      <a href="#interior" class="hover:text-white transition-colors">Interior</a>
      <a href="#performance" class="hover:text-white transition-colors">Performance</a>
      <a href="#specs" class="hover:text-white transition-colors">Specs</a>
      <a href="#accessories" class="hover:text-white transition-colors">Accessories</a>
    </div>

    <!-- Sub-nav Actions -->
    <div class="flex items-center gap-2.5">
      <button id="open-demo-drive-sub" class="hidden sm:inline-block px-3 py-1 rounded border border-white/20 hover:border-white/50 text-neutral-200 hover:text-white font-medium transition-all">
        Demo Drive
      </button>
      <a href="#order" class="px-4 py-1 rounded bg-white text-black font-semibold hover:bg-neutral-200 transition-all shadow-[0_0_15px_rgba(255,255,255,0.2)]">
        Order Now
      </a>
    </div>
  </div>

  <!-- Mega Menu Dropdown -->
  <MegaMenu />
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-drawer" class="fixed inset-0 bg-black/95 backdrop-blur-2xl z-50 hidden flex-col justify-between p-8 text-neutral-200 transition-all duration-300">
  <div>
    <div class="flex items-center justify-between pb-6 border-b border-white/10">
      <span class="font-['Chakra_Petch',sans-serif] font-bold text-lg tracking-wider text-white">CYBERTRUCK</span>
      <button id="close-mobile-menu" class="p-2 text-neutral-400 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="flex flex-col gap-5 mt-8 text-lg font-medium">
      <a href="#adventure" class="mobile-link hover:text-white">Adventure & Clearance</a>
      <a href="#exoskeleton" class="mobile-link hover:text-white">Exoskeleton Body</a>
      <a href="#armor-glass" class="mobile-link hover:text-white">Armor Glass Impact</a>
      <a href="#vault" class="mobile-link hover:text-white">The Vault & Cargo</a>
      <a href="#powershare" class="mobile-link hover:text-white">PowerShare Outlets</a>
      <a href="#interior" class="mobile-link hover:text-white">Cyber Cabin Interior</a>
      <a href="#performance" class="mobile-link hover:text-white">Beast Mode Performance</a>
      <a href="#specs" class="mobile-link hover:text-white">Full Specifications</a>
      <a href="#accessories" class="mobile-link hover:text-white">Accessories</a>
      <a href="#order" class="mobile-link text-white font-bold">Custom Order Configurator</a>
    </div>
  </div>

  <div class="flex flex-col gap-3 pt-6 border-t border-white/10">
    <a href="#order" class="w-full py-3 text-center bg-white text-black font-bold rounded">
      Order Now
    </a>
    <button id="open-demo-drive-mobile" class="w-full py-3 text-center border border-white/20 text-white font-medium rounded hover:bg-white/10">
      Schedule Demo Drive
    </button>
  </div>
</div>

<script>
  import { playCyberClick } from '../utils/cyberSound';

  // Mega menu toggle handling
  const megaMenu = document.getElementById('mega-menu');
  const navItems = document.querySelectorAll('.nav-item');
  const panels = document.querySelectorAll('.mega-panel');

  navItems.forEach((btn) => {
    btn.addEventListener('mouseenter', () => {
      const panelId = btn.getAttribute('data-panel');
      if (megaMenu && panelId) {
        megaMenu.classList.remove('hidden');
        panels.forEach((p) => p.classList.add('hidden'));
        const activePanel = document.getElementById(panelId);
        if (activePanel) activePanel.classList.remove('hidden');
      }
    });
  });

  const siteHeader = document.getElementById('site-header');
  siteHeader?.addEventListener('mouseleave', () => {
    megaMenu?.classList.add('hidden');
  });

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const closeMobileMenu = document.getElementById('close-mobile-menu');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileDrawer?.classList.remove('hidden');
    mobileDrawer?.classList.add('flex');
    playCyberClick();
  });

  closeMobileMenu?.addEventListener('click', () => {
    mobileDrawer?.classList.add('hidden');
    mobileDrawer?.classList.remove('flex');
    playCyberClick();
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileDrawer?.classList.add('hidden');
      mobileDrawer?.classList.remove('flex');
    });
  });
</script>
