---
// Tesla Official End-of-Page Hero & Global Footer (Matching Tesla screenshots e122b4a9 & 1ea0d1a1)
const endOfPageBg = `${import.meta.env.BASE_URL}Cybertruck-End-of-Page-Desktop-NA-v2.avif`;
const graffitiLogo = `${import.meta.env.BASE_URL}cybertruck-graffiti.svg`;
const currentYear = new Date().getFullYear();
---

<footer class="relative w-full bg-black text-white select-none overflow-hidden">
  <!-- End of Page Visual Hero Layout (Matching Screenshots e122b4a9 & 1ea0d1a1) -->
  <div class="relative w-full min-h-[75vh] sm:min-h-[85vh] lg:min-h-[92vh] flex flex-col justify-between items-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src={endOfPageBg}
        alt="Cybertruck canyon overlook"
        class="w-full h-full object-cover object-center"
        loading="lazy"
      />
      <!-- Subtle top and bottom vignette gradient for text legibility -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-transparent to-black/80 pointer-events-none"></div>
    </div>

    <!-- Center Content: Graffiti Logo & CTAs -->
    <div class="relative z-10 pt-24 sm:pt-28 md:pt-36 flex flex-col items-center px-4 w-full max-w-4xl mx-auto text-center">
      <!-- Graffiti CYBERTRUCK Logo -->
      <div class="w-full max-w-[320px] sm:max-w-[420px] md:max-w-[480px] drop-shadow-[0_10px_35px_rgba(0,0,0,0.8)]">
        <img
          src={graffitiLogo}
          alt="CYBERTRUCK"
          class="w-full h-auto filter invert brightness-200"
        />
      </div>

      <!-- Action Buttons: Order Now & Compare Models -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-7 w-full max-w-sm sm:max-w-md mx-auto">
        <!-- Order Now (Tesla Electric Blue) -->
        <a
          href="#order"
          class="w-full sm:w-1/2 py-2.5 px-6 rounded bg-[#3e6ae1] hover:bg-[#345abf] text-white font-medium text-sm tracking-tight text-center transition-all shadow-md active:scale-[0.98]"
        >
          Order Now
        </a>

        <!-- Compare Models (Solid Crisp White) -->
        <a
          href="#specs"
          class="w-full sm:w-1/2 py-2.5 px-6 rounded bg-white hover:bg-neutral-100 text-[#171a20] font-medium text-sm tracking-tight text-center transition-all shadow-md active:scale-[0.98]"
        >
          Compare Models
        </a>
      </div>
    </div>

    <!-- Bottom Footer Links Bar (Matching Screenshot 2: 1ea0d1a1) -->
    <div class="relative z-10 w-full pb-16 sm:pb-20 pt-10 px-4">
      <div class="flex flex-wrap items-center justify-center gap-x-5 sm:gap-x-6 gap-y-2 text-xs text-neutral-300 font-normal">
        <span>Tesla © {currentYear}</span>
        <a href="https://www.tesla.com/legal" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Privacy & Legal
        </a>
        <a href="https://www.tesla.com/vin-recall-search" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Vehicle Recalls
        </a>
        <a href="https://www.tesla.com/contact" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Contact
        </a>
        <a href="https://www.tesla.com/blog" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          News
        </a>
        <a href="#order" class="hover:text-white transition-colors">
          Get Updates
        </a>
        <a href="https://www.tesla.com/findus" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Locations
        </a>
        <a href="https://www.tesla.com/learn" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Learn
        </a>
      </div>
    </div>
  </div>
</footer>
