---
// Tesla Official End-of-Page Hero & Global Footer (Matching Tesla screenshots e122b4a9 & 1ea0d1a1)
const endOfPageBg = `${import.meta.env.BASE_URL}Cybertruck-End-of-Page-Desktop-NA-v2.avif`;
const graffitiLogo = `${import.meta.env.BASE_URL}cybertruck-graffiti.svg`;
const currentYear = new Date().getFullYear();
---

<footer class="relative w-full bg-black text-white select-none overflow-hidden" style="font-family: 'Blender TSL', -apple-system, Arial, sans-serif;">
  <!-- End of Page Visual Hero Layout (Matching Tesla screenshot bcf2ec57) -->
  <div class="relative w-full min-h-screen flex flex-col justify-between items-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src={endOfPageBg}
        alt="Cybertruck canyon overlook"
        class="w-full h-full object-cover object-center"
        loading="lazy"
      />
      <!-- Subtle top and bottom vignette gradient for text legibility & solid black footer base -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-transparent to-black pointer-events-none"></div>
    </div>

    <!-- Center Content: Graffiti Logo & CTAs -->
    <div class="relative z-10 pt-20 sm:pt-24 md:pt-28 flex flex-col items-center px-4 w-full max-w-4xl mx-auto text-center">
      <!-- Graffiti CYBERTRUCK Logo -->
      <div class="w-full max-w-[320px] sm:max-w-[420px] md:max-w-[480px] drop-shadow-[0_10px_35px_rgba(0,0,0,0.8)]">
        <img
          src={graffitiLogo}
          alt="CYBERTRUCK"
          class="w-full h-auto filter invert brightness-200"
        />
      </div>

      <!-- Action Buttons: Order Now & Compare Models (Exact 250px x 50px sharp rectangular styling from screenshot bcf2ec57) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 mt-7 w-full max-w-[510px] mx-auto">
        <!-- Order Now (Tesla Electric Blue #3e6ae1, sharp corners, 250x50) -->
        <a
          href="#order"
          class="w-full sm:w-[250px] h-[50px] rounded-none inline-flex items-center justify-center bg-[#3e6ae1] hover:bg-[#345abf] text-white font-['Blender_TSL',sans-serif] font-medium text-[15px] tracking-wide text-center transition-all active:scale-[0.99] shadow-sm box-border border-0"
        >
          Order Now
        </a>

        <!-- Compare Models (Solid Crisp White #ffffff, sharp corners, 250x50) -->
        <a
          href="#specs"
          class="w-full sm:w-[250px] h-[50px] rounded-none inline-flex items-center justify-center bg-white hover:bg-neutral-100 text-[#171a20] font-['Blender_TSL',sans-serif] font-medium text-[15px] tracking-wide text-center transition-all active:scale-[0.99] shadow-sm box-border border-0"
        >
          Compare Models
        </a>
      </div>
    </div>

    <!-- Bottom Footer Links Bar (Sitting gracefully above floating bar matching screenshot bcf2ec57) -->
    <div class="relative z-10 w-full pb-20 sm:pb-24 pt-8 px-4">
      <div class="flex flex-wrap items-center justify-center gap-x-5 sm:gap-x-6 gap-y-2 text-xs sm:text-[12.5px] text-neutral-300 font-normal">
        <span>Tesla © {currentYear}</span>
        <a href="https://www.tesla.com/legal" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Privacy & Legal
        </a>
        <a href="https://www.tesla.com/vin-recall-search" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Vehicle Recalls
        </a>
        <a href="https://www.tesla.com/contact" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Contact
        </a>
        <a href="https://www.tesla.com/blog" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          News
        </a>
        <a href="#order" class="hover:text-white transition-colors">
          Get Updates
        </a>
        <a href="https://www.tesla.com/findus" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Locations
        </a>
        <a href="https://www.tesla.com/learn" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Learn
        </a>
      </div>
    </div>
  </div>
</footer>
