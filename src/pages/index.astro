---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import RedefiningTruck from '../components/RedefiningTruck.astro';
import InsideOutside from '../components/InsideOutside.astro';
import Footer from '../components/Footer.astro';
import StickyBottomBar from '../components/StickyBottomBar.astro';
import DemoDriveModal from '../components/DemoDriveModal.astro';
---

<Layout
  title="Cybertruck | Tesla"
  description="Cybertruck is built for any adventure. With an ultra-hard stainless-steel exoskeleton, shatter-resistant armor glass, all-terrain capability and 11,000 lbs towing capacity."
>
  <main class="relative bg-white pb-16 sm:pb-20">
    <Navbar />
    <Hero />
    <RedefiningTruck />
    <InsideOutside />
    <Footer />
    <StickyBottomBar />
    <DemoDriveModal />
  </main>
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Smooth Section Title & Card Reveals
  const sections = document.querySelectorAll('section');
  sections.forEach((sec) => {
    const titles = sec.querySelectorAll('h2, .hero-title, .hero-subtitle');
    if (titles.length) {
      gsap.from(titles, {
        scrollTrigger: {
          trigger: sec,
          start: 'top 80%',
          toggleActions: 'play none none none',
        },
        opacity: 0,
        y: 35,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out',
      });
    }
  });
</script>
